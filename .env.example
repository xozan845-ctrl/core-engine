# ── Core Engine · Variables de DESARROLLO (plantilla) ─────────────────────
# Copia este archivo a `.env` para desarrollo local
# (`docker compose -f docker-compose.dev.yml up`).
# `.env` está en .gitignore: nunca se versiona.
# Para PRODUCCIÓN usa `.env.production.example` (secretos reales y únicos).

# Timezone fija de runtime (R-FL-3)
TZ=America/Managua

# Postgres (Docker Compose levanta la instancia local "supabase-compatible")
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=core_engine
POSTGRES_USER=core_engine
POSTGRES_PASSWORD=core_engine_dev
POSTGRES_URL=postgres://core_engine:core_engine_dev@postgres:5432/core_engine
CORE_ENGINE_APP_PASSWORD=core_engine_dev

# Conexion de los microservicios (esquema por dominio; DATABASE_URL es la usada)
DATABASE_URL=postgres://core_engine_app:core_engine_dev@postgres:5432/core_engine

# RabbitMQ: credencial dedicada de `infra/rabbitmq/rabbitmq.conf` (guest esta
# deshabilitado en loopback). El RABBITMQ_URL debe usar esa misma credencial.
RABBITMQ_USER=core-engine
RABBITMQ_PASSWORD=0b66c112e3ceca4e3b6a648219c88c60
RABBITMQ_URL=amqp://core-engine:0b66c112e3ceca4e3b6a648219c88c60@rabbitmq:5672

# MinIO: almacenamiento de objetos con UN BUCKET POR TENANT (ADR-24).
# La credencial es del servicio (root local) y no debe reutilizarse en otros entornos.
MINIO_ROOT_USER=core-engine-minio
MINIO_ROOT_PASSWORD=core_engine_minio_dev
MINIO_ENDPOINT=minio
MINIO_PORT=9000
MINIO_USE_SSL=false
# Endpoint PUBLICO que va firmado en las URLs prefirmadas (el que resuelve el
# cliente final). En local, el puerto 9000 del compose.
MINIO_PUBLIC_ENDPOINT=localhost
MINIO_PUBLIC_PORT=9000
MINIO_PUBLIC_USE_SSL=false

# Limites del servicio de almacenamiento (bytes/segundos)
STORAGE_BUCKET_PREFIX=t-
STORAGE_MAX_OBJETO_BYTES=26214400
# Los videos de fondo tienen un limite propio (100 MiB por defecto).
STORAGE_MAX_VIDEO_BYTES=104857600
STORAGE_CUOTA_DEFAULT_BYTES=5368709120
STORAGE_URL_TTL_SEGUNDOS=900

# Outbox (R-AR-3): tabla outbox que usa OutboxService para el polling.
# Debe incluir el schema del servicio (ej: orders.outbox, stores.outbox).
# El servicio que gestiona el outbox define su propio valor en su configuracion.
# Si no se define, el fallback es 'outbox' (sin schema), que puede fallar en
# entornos con schema-per-service. Cada servicio debe declarar su valor propio.
OUTBOX_TABLA=outbox

# JWT (Supabase-compatible: misma firma HS256; en producción usar SUPABASE_JWT_SECRET)
JWT_SECRET=dev_secret_cambiar_en_produccion
JWT_ACCESS_TTL=900s
JWT_REFRESH_TTL=7d
# En producción se activa por defecto; en dev/tests queda desactivado.
AUTH_EXIGIR_CORREO_VERIFICADO=false
# Cifrado de secretos MFA en reposo (AES-256-GCM). Base64 de 32 bytes.
# En desarrollo se deriva de JWT_SECRET si no se define.
# STORAGE_SERVICE_URL=http://storage-service:3010
PDF_ALMACENAMIENTO=storage
MFA_ENCRYPTION_KEY=
# Retención de identity.auditoria en días (0 = conservar siempre).
AUDITORIA_RETENCION_DIAS=365
AUDITORIA_RETENCION_MODO=anonimizar
EXPORT_SIGNING_KEY=dev_export_signing_key_cambiar_en_produccion
# Servicios que reciben la purga de tenant: nombre=url,nombre=url.
# Por defecto solo storage; añadir orders/finance/etc. cuando estén desplegados.
# TENANT_PURGE_SERVICES=commissions=http://commissions-service:3006,logistics=http://logistics-service:3005,analytics=http://analytics-service:3016,inventory=http://inventory-service:3013,pricing=http://pricing-service:3014,stores=http://stores-service:3003,item=http://item-service:3015,finance=http://finance-service:3007,storage=http://storage-service:3010,field=http://field-service:3008,intelligence=http://market-intelligence-service:3009,scheduling=http://scheduling-service:3011,notifications=http://notifications-service:3012,orders=http://orders-service:3004


# Clave interna entre servicios (API Gateway y llamadas servicio->servicio)
PAGO_WEBHOOK_SECRET=dev_webhook_secret_cambiar_en_produccion
PAGO_PROVEEDOR=simulado
# PAGO_PROVEEDOR_URL=https://pasarela.ejemplo
# PAGO_PROVEEDOR_KEY=cambiar_en_produccion
INTERNAL_API_KEY=dev_internal_key_cambiar_en_produccion
# Solo activar si el gateway está detrás de un proxy de confianza.
TRUST_FORWARDED_FOR=false

# Seed del administrador (identity-service los crea en el primer arranque)
ADMIN_EMAIL=admin@core-engine.test
ADMIN_PASSWORD=AdminCore Engine2026!

# Comisión de la plataforma (RN-04, default 12 %)
COMMISSION_RATE=0.12
# Expiración de órdenes impagas: TTL en minutos (0 desactiva) y frecuencia del barrido
ORDEN_PAGO_TTL_MINUTOS=30
ORDEN_EXPIRACION_INTERVALO_SEGUNDOS=60

# Tenant de field-service que representa la flota global de la plataforma.
PLATFORM_LOGISTICS_TENANT_ID=00000000-0000-4000-8000-000000000001
# Tenant dueno de los assets de la plataforma (fondo del sitio). Los roles
# globales sin tenant en el JWT suben a este bucket.
PLATFORM_TENANT_ID=00000000-0000-0000-0000-000000000002

# Logs / observabilidad
LOG_LEVEL=info
OTEL_EXPORTER_OTLP_ENDPOINT=

# CORS permitidos por el Gateway (separados por coma)
CORS_ORIGINS=*

# Diagnostico del borde: en desarrollo /docs y /metrics van abiertos; en
# stage/produccion el gateway los oculta (404) salvo con la clave interna.
DIAGNOSTICOS_PUBLICOS=true
# /ready publico en local (sin clave interna ni proxy de borde).
READY_PUBLIC=true
READY_CACHE_MS=5000
# Acceso directo al gateway en local: no confiar en X-Forwarded-For.
TRUST_PROXY=false

# Observabilidad: solo se lee si se usa `docker-compose.observability.yml`
GRAFANA_ADMIN_PASSWORD=admin

# Correo transaccional (ADR-0003). En dev/test se usa log; para SMTP rellenar.
EMAIL_MODE=log
EMAIL_FROM=no-reply@core-engine.local
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# URL pública del frontend (enlaces de incorporación y reset de contraseña).
FRONTEND_URL=http://localhost:5173

# Facturación electrónica (opt-in por negocio; sin URL usa el simulado)
# FACTURACION_PROVEEDOR_URL=https://proveedor-fiscal.ejemplo
# FACTURACION_PROVEEDOR_KEY=cambiar_en_produccion
