# ── Core Engine · Variables de DESARROLLO (plantilla) ─────────────────────
# Genera `.env` con secretos aleatorios para ESTA máquina:
#   npm run env:dev
# Luego levanta el stack:
#   docker compose -f docker-compose.dev.yml up
# `.env` está en .gitignore: nunca se versiona.
# Para PRODUCCIÓN usa `.env.production.example` (secretos reales y únicos).

# Timezone fija de runtime (R-FL-3)
TZ=America/Managua

# Postgres (Docker Compose levanta la instancia local "supabase-compatible")
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=core_engine
POSTGRES_USER=core_engine
# `npm run env:dev` reemplaza los placeholders y reconstruye las URLs.
POSTGRES_PASSWORD=<GENERAR_CON_NPM_RUN_ENV_DEV>
# Password del rol de aplicación core_engine_app (NOSUPERUSER NOBYPASSRLS).
APP_DB_PASSWORD=<GENERAR_CON_NPM_RUN_ENV_DEV>
# URL de administración/migraciones (superusuario del contenedor).
POSTGRES_URL=postgres://core_engine:<GENERAR_CON_NPM_RUN_ENV_DEV>@postgres:5432/core_engine

# Conexion de los microservicios (rol de aplicación, sujeto a RLS).
DATABASE_URL=postgres://core_engine_app:<GENERAR_CON_NPM_RUN_ENV_DEV>@postgres:5432/core_engine
# RLS: SET ROLE authenticated + claims por usuario; background usa el rol de servicio.
DB_RLS_ENABLED=true
DB_SERVICE_ROLE=core_engine_service

# RabbitMQ: credencial dedicada de `infra/rabbitmq/rabbitmq.conf` (guest esta
# deshabilitado en loopback). El RABBITMQ_URL debe usar esa misma credencial.
RABBITMQ_USER=core-engine
RABBITMQ_PASSWORD=<GENERAR_CON_NPM_RUN_ENV_DEV>
RABBITMQ_URL=amqp://core-engine:<GENERAR_CON_NPM_RUN_ENV_DEV>@rabbitmq:5672

# MinIO: almacenamiento de objetos con UN BUCKET POR TENANT (ADR-24).
# La credencial es del servicio (root local) y no debe reutilizarse en otros entornos.
MINIO_ROOT_USER=core-engine-minio
MINIO_ROOT_PASSWORD=<GENERAR_CON_NPM_RUN_ENV_DEV>
MINIO_ENDPOINT=minio
MINIO_PORT=9000
MINIO_USE_SSL=false
# Endpoint PUBLICO que va firmado en las URLs prefirmadas (el que resuelve el
# cliente final). En local, el puerto 9000 del compose.
MINIO_PUBLIC_ENDPOINT=localhost
MINIO_PUBLIC_PORT=9000
MINIO_PUBLIC_USE_SSL=false

# Limites del servicio de almacenamiento (bytes/segundos)
STORAGE_BUCKET_PREFIX=t-
STORAGE_MAX_OBJETO_BYTES=26214400
# Los videos de fondo tienen un limite propio (100 MiB por defecto).
STORAGE_MAX_VIDEO_BYTES=104857600
STORAGE_CUOTA_DEFAULT_BYTES=5368709120
STORAGE_URL_TTL_SEGUNDOS=900

# Outbox (R-AR-3): tabla outbox que usa OutboxService para el polling.
# Debe incluir el schema del servicio (ej: orders.outbox, stores.outbox).
# El servicio que gestiona el outbox define su propio valor en su configuracion.
# Si no se define, el fallback es 'outbox' (sin schema), que puede fallar en
# entornos con schema-per-service. Cada servicio debe declarar su valor propio.
OUTBOX_TABLA=outbox

# JWT (Supabase-compatible: misma firma HS256; en producción usar SUPABASE_JWT_SECRET)
# `npm run env:dev` reemplaza este placeholder por un secreto aleatorio.
JWT_SECRET=<GENERAR_CON_NPM_RUN_ENV_DEV>
JWT_ACCESS_TTL=900s
JWT_REFRESH_TTL=7d

# Clave interna entre servicios (API Gateway y llamadas servicio->servicio)
# `npm run env:dev` reemplaza este placeholder por una clave aleatoria.
INTERNAL_API_KEY=<GENERAR_CON_NPM_RUN_ENV_DEV>

# Seed del administrador (identity-service los crea en el primer arranque).
# Sin estas variables no se siembra ningún administrador (no hay contraseña por defecto).
ADMIN_EMAIL=admin@core-engine.test
ADMIN_PASSWORD=<GENERAR_CON_NPM_RUN_ENV_DEV>

# Comisión de la plataforma (RN-04, default 12 %)
COMMISSION_RATE=0.12

# Tenant de field-service que representa la flota global de la plataforma.
PLATFORM_LOGISTICS_TENANT_ID=00000000-0000-0000-0000-000000000001
# Tenant dueno de los assets de la plataforma (fondo del sitio). Los roles
# globales sin tenant en el JWT suben a este bucket.
PLATFORM_TENANT_ID=00000000-0000-0000-0000-000000000002

# Logs / observabilidad
LOG_LEVEL=info
OTEL_EXPORTER_OTLP_ENDPOINT=

# CORS permitidos por el Gateway (separados por coma)
CORS_ORIGINS=*

# Diagnostico del borde: en desarrollo /docs y /metrics van abiertos; en
# stage/produccion el gateway los oculta (404) salvo con la clave interna.
DIAGNOSTICOS_PUBLICOS=true
# /ready publico en local (sin clave interna ni proxy de borde).
READY_PUBLIC=true
READY_CACHE_MS=5000
# Acceso directo al gateway en local: no confiar en X-Forwarded-For.
# `loopback` confia solo en el proxy local (/api-proxy) y no en un
# X-Forwarded-For enviado por un cliente remoto. En produccion: 1 o el CIDR del borde.
TRUST_PROXY=loopback

# Observabilidad: solo se lee si se usa `docker-compose.observability.yml`
GRAFANA_ADMIN_PASSWORD=admin
