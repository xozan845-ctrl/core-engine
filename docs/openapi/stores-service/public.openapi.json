{
  "openapi": "3.0.0",
  "info": {
    "title": "Core Engine · stores-service · API pública",
    "description": "Contrato público (/api/v1/**) de stores-service. No contiene rutas /internal/**.",
    "version": "v1",
    "contact": {}
  },
  "x-servicio": "stores-service",
  "x-superficie": "publica",
  "tags": [],
  "paths": {
    "/api/v1/vendedores/tienda": {
      "post": {
        "operationId": "TiendasController_crear",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CrearTiendaRequestDto"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Tienda creada",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TiendaResponseDto"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "Crear la tienda del vendedor autenticado",
        "tags": [
          "Tiendas"
        ]
      }
    },
    "/api/v1/vendedores/me/tienda": {
      "get": {
        "operationId": "TiendasController_miTienda",
        "parameters": [],
        "responses": {
          "200": {
            "description": "Tienda del vendedor",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TiendaResponseDto"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "Tienda del vendedor autenticado",
        "tags": [
          "Tiendas"
        ]
      }
    },
    "/api/v1/empresarios/me/tiendas": {
      "get": {
        "operationId": "TiendasEmpresaController_listar",
        "parameters": [],
        "responses": {
          "200": {
            "description": "Tiendas de la empresa",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/TiendaResponseDto"
                  }
                }
              }
            }
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "Tiendas de la empresa autenticada",
        "tags": [
          "Tiendas"
        ]
      }
    },
    "/api/v1/tiendas/{id}/logo": {
      "patch": {
        "operationId": "TiendasSlugController_actualizarLogo",
        "parameters": [
          {
            "name": "id",
            "required": true,
            "in": "path",
            "description": "UUID de la tienda o su slug actual",
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ActualizarLogoTiendaRequestDto"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Logo actualizado",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TiendaResponseDto"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "Asociar o quitar el logo público de la tienda",
        "tags": [
          "Tiendas"
        ]
      }
    },
    "/api/v1/tiendas/{id}/background": {
      "patch": {
        "operationId": "TiendasSlugController_actualizarBackground",
        "parameters": [
          {
            "name": "id",
            "required": true,
            "in": "path",
            "description": "UUID de la tienda o su slug actual",
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ActualizarBackgroundTiendaRequestDto"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Fondo actualizado",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TiendaResponseDto"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "Asociar, cambiar o quitar el fondo público de la tienda",
        "tags": [
          "Tiendas"
        ]
      }
    },
    "/api/v1/tiendas/{id}/slug": {
      "patch": {
        "operationId": "TiendasSlugController_actualizarSlug",
        "parameters": [
          {
            "name": "id",
            "required": true,
            "in": "path",
            "description": "UUID de la tienda o su slug actual/anterior",
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ActualizarSlugTiendaRequestDto"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Slug actualizado",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TiendaResponseDto"
                }
              }
            }
          },
          "403": {
            "description": "El usuario no es propietario de la tienda"
          },
          "409": {
            "description": "El slug ya está en uso (incluye slugs históricos)"
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "Cambiar el slug público; los anteriores redirigen 301",
        "tags": [
          "Tiendas"
        ]
      }
    },
    "/api/v1/vendedores/productos": {
      "post": {
        "operationId": "OfertasController_publicar",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PublicarProductoRequestDto"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Oferta creada",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OfertaResponseDto"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "Publicar un producto con margen (vendedor)",
        "tags": [
          "Tiendas"
        ]
      }
    },
    "/api/v1/vendedores/productos/{id}": {
      "patch": {
        "operationId": "OfertasController_cambiarMargen",
        "parameters": [
          {
            "name": "id",
            "required": true,
            "in": "path",
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CambiarMargenRequestDto"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Oferta actualizada",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OfertaResponseDto"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "Cambiar el margen de una oferta (vendedor)",
        "tags": [
          "Tiendas"
        ]
      }
    },
    "/api/v1/vendedores/me/ofertas": {
      "get": {
        "operationId": "OfertasController_misOfertas",
        "parameters": [],
        "responses": {
          "200": {
            "description": "Página de ofertas",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PaginaOfertasResponseDto"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "Listar las ofertas del vendedor autenticado",
        "tags": [
          "Tiendas"
        ]
      }
    },
    "/api/v1/tiendas/{id}": {
      "get": {
        "operationId": "OfertasController_tiendaPublica",
        "parameters": [
          {
            "name": "id",
            "required": true,
            "in": "path",
            "description": "UUID de la tienda o su slug público actual/anterior. Un slug anterior responde 301.",
            "schema": {
              "example": "mi-tienda",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Tienda con sus ofertas",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TiendaPublicaResponseDto"
                }
              }
            }
          },
          "301": {
            "description": "Slug anterior; Location apunta al slug actual",
            "headers": {
              "Location": {
                "description": "Ruta con el slug actual",
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "404": {
            "description": "Tienda inexistente (NO_ENCONTRADO)"
          }
        },
        "summary": "Tienda pública con sus ofertas (UUID o slug; ruta pública)",
        "tags": [
          "Tiendas"
        ]
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearer": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http"
      },
      "internalKey": {
        "type": "apiKey",
        "in": "header",
        "name": "x-internal-key"
      }
    },
    "schemas": {
      "ActualizarBackgroundTiendaRequestDto": {
        "type": "object",
        "properties": {
          "background_objeto_id": {
            "type": "string",
            "description": "Objeto de storage del fondo; null limpia el bloque completo",
            "nullable": true,
            "format": "uuid"
          },
          "background_poster_objeto_id": {
            "type": "string",
            "description": "Imagen de portada para un fondo de video",
            "nullable": true,
            "format": "uuid"
          },
          "background_alt": {
            "type": "string",
            "maxLength": 160
          },
          "background_overlay": {
            "type": "number",
            "minimum": 0,
            "maximum": 100,
            "default": 35
          },
          "background_position": {
            "type": "string",
            "enum": [
              "center",
              "top",
              "bottom",
              "left",
              "right"
            ],
            "default": "center"
          },
          "background_activo": {
            "type": "boolean",
            "default": false
          }
        }
      },
      "ActualizarLogoTiendaRequestDto": {
        "type": "object",
        "properties": {
          "logo_objeto_id": {
            "type": "object",
            "description": "Objeto de storage público confirmado como imagen; null para quitar el logo",
            "nullable": true,
            "format": "uuid"
          }
        }
      },
      "ActualizarSlugTiendaRequestDto": {
        "type": "object",
        "properties": {
          "slug": {
            "type": "string",
            "minLength": 2,
            "maxLength": 80,
            "example": "tienda-de-la-vendedora"
          }
        },
        "required": [
          "slug"
        ]
      },
      "CambiarMargenRequestDto": {
        "type": "object",
        "properties": {
          "margen": {
            "type": "number",
            "description": "Nuevo margen en enteros (0 a 90)",
            "minimum": 0,
            "maximum": 90,
            "example": 20
          }
        },
        "required": [
          "margen"
        ]
      },
      "CrearTiendaRequestDto": {
        "type": "object",
        "properties": {
          "nombre": {
            "type": "string",
            "description": "Nombre de la tienda",
            "minLength": 2,
            "maxLength": 100,
            "example": "Mi tienda"
          },
          "descripcion": {
            "type": "string",
            "description": "Descripción de la tienda",
            "example": "Ropa y accesorios"
          },
          "slug": {
            "type": "string",
            "description": "Slug público. Si se omite se deriva del nombre y se resuelven colisiones con sufijos.",
            "minLength": 2,
            "maxLength": 80,
            "example": "tienda-de-la-vendedora-piloto"
          }
        },
        "required": [
          "nombre"
        ]
      },
      "OfertaResponseDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "Id de la oferta",
            "format": "uuid"
          },
          "tienda_id": {
            "type": "string",
            "description": "Id de la tienda",
            "format": "uuid"
          },
          "vendedor_id": {
            "type": "string",
            "description": "Id del vendedor",
            "format": "uuid"
          },
          "empresa_id": {
            "type": "string",
            "description": "Empresa propietaria",
            "format": "uuid"
          },
          "participacion_porcentaje": {
            "type": "number",
            "description": "Participación congelable del vendedor",
            "minimum": 0,
            "maximum": 100
          },
          "producto_id": {
            "type": "string",
            "description": "Id del producto o variante vendible",
            "format": "uuid"
          },
          "producto_padre_id": {
            "type": "object",
            "description": "Id del producto padre (si es variante)",
            "nullable": true,
            "format": "uuid"
          },
          "sku": {
            "type": "string",
            "description": "SKU de la variante o producto",
            "example": "SKU-001"
          },
          "producto_nombre": {
            "type": "string",
            "description": "Nombre del producto/variante"
          },
          "atributos": {
            "type": "object",
            "description": "Atributos de la variante (color, talla, etc.)",
            "additionalProperties": true
          },
          "imagen_objeto_id": {
            "type": "object",
            "description": "Id del objeto de la imagen principal",
            "nullable": true,
            "format": "uuid"
          },
          "imagen_url": {
            "type": "object",
            "description": "URL pública de la imagen principal",
            "nullable": true
          },
          "margen": {
            "type": "number",
            "description": "Margen aplicado (0–90)",
            "example": 15
          },
          "precio_base": {
            "type": "string",
            "description": "Precio base en córdobas con dos decimales",
            "example": "1000.00"
          },
          "precio_venta": {
            "type": "string",
            "description": "Precio de venta en córdobas con dos decimales",
            "example": "1150.00"
          },
          "stock": {
            "type": "number",
            "description": "Stock disponible",
            "example": 10
          },
          "estado": {
            "type": "string",
            "description": "Estado de la oferta",
            "example": "activa"
          },
          "creado_en": {
            "type": "string",
            "description": "Fecha de creación (ISO 8601 UTC)",
            "format": "date-time"
          }
        },
        "required": [
          "id",
          "tienda_id",
          "vendedor_id",
          "empresa_id",
          "participacion_porcentaje",
          "producto_id",
          "sku",
          "producto_nombre",
          "margen",
          "precio_base",
          "precio_venta",
          "stock",
          "estado",
          "creado_en"
        ]
      },
      "PaginaOfertasResponseDto": {
        "type": "object",
        "properties": {
          "items": {
            "description": "Ofertas de la página",
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/OfertaResponseDto"
            }
          },
          "total": {
            "type": "number",
            "description": "Total de ofertas",
            "example": 42
          },
          "pagina": {
            "type": "number",
            "description": "Página actual (1-based)",
            "example": 1
          },
          "limite": {
            "type": "number",
            "description": "Tamaño de página",
            "example": 20
          },
          "paginas": {
            "type": "number",
            "description": "Total de páginas",
            "example": 3
          }
        },
        "required": [
          "items",
          "total",
          "pagina",
          "limite",
          "paginas"
        ]
      },
      "PublicarProductoRequestDto": {
        "type": "object",
        "properties": {
          "tienda_id": {
            "type": "string",
            "description": "Tienda donde se publicará (UUID o slug). Si se omite, se usa la tienda del vendedor autenticado.",
            "example": "mi-tienda"
          },
          "producto_id": {
            "type": "string",
            "description": "Id del producto a publicar",
            "example": "a0eebc99-9c0b-4ef8-bb6d-6bb9bd380a11"
          },
          "margen": {
            "type": "number",
            "description": "Margen en enteros (15 = 15 %). RN-01: 0 a 90",
            "minimum": 0,
            "maximum": 90,
            "example": 15
          }
        },
        "required": [
          "producto_id",
          "margen"
        ]
      },
      "TiendaPublicaResponseDto": {
        "type": "object",
        "properties": {
          "tienda": {
            "description": "Datos de la tienda",
            "allOf": [
              {
                "$ref": "#/components/schemas/TiendaResponseDto"
              }
            ]
          },
          "ofertas": {
            "description": "Ofertas de la tienda",
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/OfertaResponseDto"
            }
          }
        },
        "required": [
          "tienda",
          "ofertas"
        ]
      },
      "TiendaResponseDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "Id de la tienda",
            "format": "uuid"
          },
          "empresa_id": {
            "type": "string",
            "description": "Empresa propietaria",
            "format": "uuid"
          },
          "propietario_usuario_id": {
            "type": "string",
            "description": "Usuario propietario operativo",
            "format": "uuid"
          },
          "participacion_porcentaje": {
            "type": "number",
            "nullable": true,
            "minimum": 0,
            "maximum": 100
          },
          "vendedor_id": {
            "type": "string",
            "nullable": true,
            "description": "Id del vendedor asignado; null si la tienda está disponible",
            "format": "uuid"
          },
          "nombre": {
            "type": "string",
            "description": "Nombre de la tienda",
            "example": "Mi tienda"
          },
          "slug": {
            "type": "string",
            "description": "Slug público actual",
            "example": "mi-tienda"
          },
          "descripcion": {
            "type": "string",
            "description": "Descripción de la tienda"
          },
          "logo_objeto_id": {
            "type": "object",
            "description": "Objeto de storage del logo",
            "nullable": true,
            "format": "uuid"
          },
          "logo_url": {
            "type": "object",
            "description": "URL pública del logo",
            "nullable": true
          },
          "background_objeto_id": {
            "type": "string",
            "description": "Objeto de storage del fondo",
            "nullable": true,
            "format": "uuid"
          },
          "background_media_type": {
            "type": "string",
            "description": "Tipo derivado del fondo",
            "nullable": true,
            "enum": [
              "imagen",
              "video"
            ]
          },
          "background_url": {
            "type": "string",
            "description": "URL pública derivada del fondo",
            "nullable": true
          },
          "background_poster_objeto_id": {
            "type": "string",
            "description": "Objeto de storage del poster",
            "nullable": true,
            "format": "uuid"
          },
          "background_poster_url": {
            "type": "string",
            "description": "URL pública derivada del poster",
            "nullable": true
          },
          "background_alt": {
            "type": "string",
            "description": "Texto alternativo del fondo"
          },
          "background_overlay": {
            "type": "number",
            "description": "Opacidad del overlay (0-100)",
            "minimum": 0,
            "maximum": 100
          },
          "background_position": {
            "type": "string",
            "description": "Posición del fondo",
            "enum": [
              "center",
              "top",
              "bottom",
              "left",
              "right"
            ]
          },
          "background_activo": {
            "type": "boolean",
            "description": "Si el fondo está activo"
          },
          "creado_en": {
            "type": "string",
            "description": "Fecha de creación (ISO 8601 UTC)",
            "format": "date-time"
          },
          "actualizado_en": {
            "type": "string",
            "description": "Última actualización (ISO 8601 UTC)",
            "format": "date-time"
          }
        },
        "required": [
          "id",
          "empresa_id",
          "propietario_usuario_id",
          "nombre",
          "descripcion",
          "creado_en"
        ]
      }
    }
  }
}
