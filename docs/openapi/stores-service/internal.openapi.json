{
  "openapi": "3.0.0",
  "info": {
    "title": "Core Engine · stores-service · API interna",
    "description": "Contrato interno (/internal/**) de stores-service; requiere x-internal-key.",
    "version": "internal",
    "contact": {}
  },
  "x-servicio": "stores-service",
  "x-superficie": "interna",
  "security": [
    {
      "internalKey": []
    }
  ],
  "tags": [],
  "paths": {
    "/internal/ofertas": {
      "get": {
        "operationId": "InternalController_porIds",
        "parameters": [
          {
            "name": "ids",
            "required": false,
            "in": "query",
            "description": "Ids de oferta separados por coma",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Ofertas encontradas",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/OfertaResponseDto"
                  }
                }
              }
            }
          }
        },
        "security": [
          {
            "internalKey": []
          }
        ],
        "summary": "Lote de ofertas por ids (servicio→servicio)",
        "tags": [
          "Tiendas (interno)"
        ]
      }
    },
    "/internal/ofertas/producto/{productoId}/activas": {
      "get": {
        "operationId": "InternalController_activas",
        "parameters": [
          {
            "name": "productoId",
            "required": true,
            "in": "path",
            "description": "Id del producto o variante",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Total de ofertas activas",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "total": {
                      "type": "number"
                    }
                  }
                }
              }
            }
          }
        },
        "security": [
          {
            "internalKey": []
          }
        ],
        "summary": "Contar ofertas activas de un producto (servicio→servicio)",
        "tags": [
          "Tiendas (interno)"
        ]
      }
    },
    "/internal/tiendas": {
      "get": {
        "operationId": "InternalController_tiendasPorIds",
        "parameters": [
          {
            "name": "ids",
            "required": false,
            "in": "query",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Tiendas encontradas",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true
                }
              }
            }
          }
        },
        "security": [
          {
            "internalKey": []
          }
        ],
        "summary": "Tiendas por lote de ids (servicio→servicio)",
        "tags": [
          "Tiendas (interno)"
        ]
      }
    },
    "/internal/tiendas/empresa/{empresaId}": {
      "get": {
        "operationId": "InternalController_tiendasDeEmpresa",
        "parameters": [
          {
            "name": "empresaId",
            "required": true,
            "in": "path",
            "schema": {
              "format": "uuid",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Tiendas de la empresa",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true
                }
              }
            }
          }
        },
        "security": [
          {
            "internalKey": []
          }
        ],
        "summary": "Tiendas de una empresa (servicio→servicio)",
        "tags": [
          "Tiendas (interno)"
        ]
      }
    },
    "/internal/tiendas/vendedor/{vendedorId}": {
      "get": {
        "operationId": "InternalController_tiendaDeVendedor",
        "parameters": [
          {
            "name": "vendedorId",
            "required": true,
            "in": "path",
            "schema": {
              "format": "uuid",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Tienda del vendedor o null",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true
                }
              }
            }
          }
        },
        "security": [
          {
            "internalKey": []
          }
        ],
        "summary": "Tienda asignada a un vendedor (servicio→servicio)",
        "tags": [
          "Tiendas (interno)"
        ]
      }
    },
    "/internal/tiendas/{id}": {
      "get": {
        "operationId": "InternalController_tienda",
        "parameters": [
          {
            "name": "id",
            "required": true,
            "in": "path",
            "schema": {
              "format": "uuid",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Tienda encontrada",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true
                }
              }
            }
          }
        },
        "security": [
          {
            "internalKey": []
          }
        ],
        "summary": "Tienda por id (servicio→servicio)",
        "tags": [
          "Tiendas (interno)"
        ]
      }
    },
    "/internal/tiendas/{id}/asignar-vendedor": {
      "post": {
        "operationId": "InternalController_asignarVendedor",
        "parameters": [
          {
            "name": "id",
            "required": true,
            "in": "path",
            "schema": {
              "format": "uuid",
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AsignarVendedorRequestDto"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Vendedor asignado",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true
                }
              }
            }
          }
        },
        "security": [
          {
            "internalKey": []
          }
        ],
        "summary": "Asignar vendedor a una tienda (servicio→servicio)",
        "tags": [
          "Tiendas (interno)"
        ]
      }
    },
    "/internal/tiendas/{id}/desasignar-vendedor": {
      "post": {
        "operationId": "InternalController_desasignarVendedor",
        "parameters": [
          {
            "name": "id",
            "required": true,
            "in": "path",
            "schema": {
              "format": "uuid",
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/DesasignarVendedorRequestDto"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Vendedor desasignado",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true
                }
              }
            }
          }
        },
        "security": [
          {
            "internalKey": []
          }
        ],
        "summary": "Compensar asignación de vendedor (servicio→servicio)",
        "tags": [
          "Tiendas (interno)"
        ]
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearer": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http"
      },
      "internalKey": {
        "type": "apiKey",
        "in": "header",
        "name": "x-internal-key"
      }
    },
    "schemas": {
      "AsignarVendedorRequestDto": {
        "type": "object",
        "properties": {
          "usuario_id": {
            "type": "string",
            "format": "uuid"
          },
          "participacion": {
            "type": "number",
            "minimum": 0,
            "maximum": 100
          }
        },
        "required": [
          "usuario_id",
          "participacion"
        ]
      },
      "DesasignarVendedorRequestDto": {
        "type": "object",
        "properties": {
          "usuario_id": {
            "type": "string",
            "format": "uuid"
          }
        },
        "required": [
          "usuario_id"
        ]
      },
      "OfertaResponseDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "Id de la oferta",
            "format": "uuid"
          },
          "tienda_id": {
            "type": "string",
            "description": "Id de la tienda",
            "format": "uuid"
          },
          "vendedor_id": {
            "type": "string",
            "description": "Id del vendedor",
            "format": "uuid"
          },
          "empresa_id": {
            "type": "string",
            "description": "Empresa propietaria",
            "format": "uuid"
          },
          "participacion_porcentaje": {
            "type": "number",
            "description": "Participación congelable del vendedor",
            "minimum": 0,
            "maximum": 100
          },
          "item_type": {
            "type": "string",
            "description": "Tipo del item publicado",
            "enum": [
              "producto",
              "servicio",
              "alquiler"
            ]
          },
          "item_id": {
            "type": "string",
            "description": "Id del item unificado",
            "format": "uuid"
          },
          "sku": {
            "type": "string",
            "description": "SKU de la variante o producto",
            "example": "SKU-001"
          },
          "producto_nombre": {
            "type": "string",
            "description": "Nombre del producto/variante"
          },
          "atributos": {
            "type": "object",
            "description": "Atributos de la variante (color, talla, etc.)",
            "additionalProperties": true
          },
          "imagen_objeto_id": {
            "type": "object",
            "description": "Id del objeto de la imagen principal",
            "nullable": true,
            "format": "uuid"
          },
          "imagen_url": {
            "type": "object",
            "description": "URL pública de la imagen principal",
            "nullable": true
          },
          "margen": {
            "type": "number",
            "description": "Margen aplicado (0–90)",
            "example": 15
          },
          "precio_base": {
            "type": "string",
            "description": "Precio base en córdobas con dos decimales",
            "example": "1000.00"
          },
          "precio_venta": {
            "type": "string",
            "description": "Precio de venta en córdobas con dos decimales",
            "example": "1150.00"
          },
          "stock": {
            "type": "number",
            "description": "Stock disponible",
            "example": 10
          },
          "estado": {
            "type": "string",
            "description": "Estado de la oferta",
            "example": "activa"
          },
          "creado_en": {
            "type": "string",
            "description": "Fecha de creación (ISO 8601 UTC)",
            "format": "date-time"
          }
        },
        "required": [
          "id",
          "tienda_id",
          "vendedor_id",
          "empresa_id",
          "participacion_porcentaje",
          "item_type",
          "item_id",
          "sku",
          "producto_nombre",
          "margen",
          "precio_base",
          "precio_venta",
          "stock",
          "estado",
          "creado_en"
        ]
      }
    }
  }
}
