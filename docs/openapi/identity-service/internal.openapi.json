{
  "openapi": "3.0.0",
  "info": {
    "title": "Core Engine · identity-service · API interna",
    "description": "Contrato interno (/internal/**) de identity-service; requiere x-internal-key.",
    "version": "internal",
    "contact": {}
  },
  "x-servicio": "identity-service",
  "x-superficie": "interna",
  "security": [
    {
      "internalKey": []
    }
  ],
  "tags": [],
  "paths": {
    "/internal/usuarios/{id}": {
      "get": {
        "operationId": "InternalController_usuario",
        "parameters": [
          {
            "name": "id",
            "required": true,
            "in": "path",
            "description": "Id del usuario",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Usuario encontrado",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UsuarioResponseDto"
                }
              }
            }
          }
        },
        "security": [
          {
            "internalKey": []
          }
        ],
        "summary": "Usuario por id (servicio→servicio)",
        "tags": [
          "Usuarios (interno)"
        ]
      }
    },
    "/internal/vendedores": {
      "get": {
        "operationId": "InternalController_vendedores",
        "parameters": [],
        "responses": {
          "200": {
            "description": "Vendedores registrados",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/UsuarioResponseDto"
                  }
                }
              }
            }
          }
        },
        "security": [
          {
            "internalKey": []
          }
        ],
        "summary": "Listar vendedores (servicio→servicio)",
        "tags": [
          "Usuarios (interno)"
        ]
      }
    },
    "/internal/contar-vendedores": {
      "get": {
        "operationId": "InternalController_contarVendedores",
        "parameters": [],
        "responses": {
          "200": {
            "description": "Conteo de vendedores",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ContarVendedoresResponseDto"
                }
              }
            }
          }
        },
        "security": [
          {
            "internalKey": []
          }
        ],
        "summary": "Contar vendedores (servicio→servicio)",
        "tags": [
          "Usuarios (interno)"
        ]
      }
    },
    "/internal/empresas/{id}": {
      "get": {
        "operationId": "InternalController_empresa",
        "parameters": [
          {
            "name": "id",
            "required": true,
            "in": "path",
            "description": "Id de la empresa",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Empresa encontrada",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EmpresaResponseDto"
                }
              }
            }
          }
        },
        "security": [
          {
            "internalKey": []
          }
        ],
        "summary": "Empresa por id (servicio→servicio)",
        "tags": [
          "Usuarios (interno)"
        ]
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearer": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http"
      },
      "internalKey": {
        "type": "apiKey",
        "in": "header",
        "name": "x-internal-key"
      }
    },
    "schemas": {
      "ContarVendedoresResponseDto": {
        "type": "object",
        "properties": {
          "vendedores": {
            "type": "number",
            "description": "Cantidad de usuarios con rol vendedor",
            "example": 12
          }
        },
        "required": [
          "vendedores"
        ]
      },
      "EmpresaResponseDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "nombre": {
            "type": "string"
          },
          "slug": {
            "type": "string",
            "description": "Slug público actual",
            "example": "distribuidora-piloto"
          },
          "modalidad_logistica": {
            "type": "string",
            "enum": [
              "plataforma",
              "propia",
              "hibrida"
            ]
          },
          "tipo_empresa": {
            "type": "string",
            "enum": [
              "comercial",
              "logistica",
              "plataforma"
            ],
            "description": "Tipo de empresa; solo las comerciales tienen catálogo propio (ADR-27)"
          },
          "estado": {
            "type": "string"
          },
          "creado_por": {
            "type": "string",
            "format": "uuid"
          },
          "creado_en": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "nombre",
          "modalidad_logistica",
          "estado",
          "creado_por",
          "creado_en"
        ]
      },
      "UsuarioResponseDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "Id del usuario",
            "format": "uuid"
          },
          "nombre": {
            "type": "string",
            "description": "Nombre del usuario"
          },
          "correo": {
            "type": "string",
            "description": "Correo del usuario",
            "format": "email"
          },
          "rol": {
            "type": "string",
            "description": "Rol del usuario",
            "enum": [
              "admin",
              "vendedor",
              "comprador",
              "logistica",
              "coordinador",
              "supervisor",
              "operativo"
            ],
            "example": "vendedor"
          },
          "tenant_id": {
            "type": "string",
            "description": "Tenant del usuario",
            "format": "uuid"
          },
          "personal_id": {
            "type": "string",
            "description": "Ficha de personal vinculada",
            "format": "uuid"
          },
          "creado_en": {
            "type": "string",
            "description": "Fecha de creación (ISO 8601 UTC)",
            "format": "date-time"
          }
        },
        "required": [
          "id",
          "nombre",
          "correo",
          "rol",
          "creado_en"
        ]
      }
    }
  }
}
