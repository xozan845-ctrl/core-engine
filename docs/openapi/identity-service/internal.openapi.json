{
  "openapi": "3.0.0",
  "info": {
    "title": "Core Engine · identity-service · API interna",
    "description": "Contrato interno (/internal/**) de identity-service; requiere x-internal-key.",
    "version": "internal",
    "contact": {}
  },
  "x-servicio": "identity-service",
  "x-superficie": "interna",
  "security": [
    {
      "internalKey": []
    }
  ],
  "tags": [],
  "paths": {
    "/internal/usuarios/{id}": {
      "get": {
        "operationId": "InternalController_usuario",
        "parameters": [
          {
            "name": "id",
            "required": true,
            "in": "path",
            "description": "Id del usuario",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Usuario encontrado",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UsuarioResponseDto"
                }
              }
            }
          }
        },
        "security": [
          {
            "internalKey": []
          }
        ],
        "summary": "Usuario por id (servicio→servicio)",
        "tags": [
          "Usuarios (interno)"
        ]
      }
    },
    "/internal/vendedores": {
      "get": {
        "operationId": "InternalController_vendedores",
        "parameters": [],
        "responses": {
          "200": {
            "description": "Vendedores registrados",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/UsuarioResponseDto"
                  }
                }
              }
            }
          }
        },
        "security": [
          {
            "internalKey": []
          }
        ],
        "summary": "Listar vendedores (servicio→servicio)",
        "tags": [
          "Usuarios (interno)"
        ]
      }
    },
    "/internal/contar-vendedores": {
      "get": {
        "operationId": "InternalController_contarVendedores",
        "parameters": [],
        "responses": {
          "200": {
            "description": "Conteo de vendedores",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ContarVendedoresResponseDto"
                }
              }
            }
          }
        },
        "security": [
          {
            "internalKey": []
          }
        ],
        "summary": "Contar vendedores (servicio→servicio)",
        "tags": [
          "Usuarios (interno)"
        ]
      }
    },
    "/internal/empresas/{id}": {
      "get": {
        "operationId": "InternalController_empresa",
        "parameters": [
          {
            "name": "id",
            "required": true,
            "in": "path",
            "description": "Id de la empresa",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Empresa encontrada",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EmpresaResponseDto"
                }
              }
            }
          }
        },
        "security": [
          {
            "internalKey": []
          }
        ],
        "summary": "Empresa por id (servicio→servicio)",
        "tags": [
          "Usuarios (interno)"
        ]
      }
    },
    "/internal/empresas/{id}/tema": {
      "get": {
        "operationId": "InternalController_empresaTema",
        "parameters": [
          {
            "name": "id",
            "required": true,
            "in": "path",
            "description": "Id de la empresa",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Overrides de plantilla y tema de la empresa",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TemaOverridesResponseDto"
                }
              }
            }
          }
        },
        "security": [
          {
            "internalKey": []
          }
        ],
        "summary": "Overrides de tema de una empresa (servicio→servicio)",
        "tags": [
          "Usuarios (interno)"
        ]
      }
    },
    "/internal/configuracion-sitio/tema": {
      "get": {
        "operationId": "InternalController_plataformaTema",
        "parameters": [],
        "responses": {
          "200": {
            "description": "Overrides de plantilla y tema de la plataforma",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TemaOverridesResponseDto"
                }
              }
            }
          }
        },
        "security": [
          {
            "internalKey": []
          }
        ],
        "summary": "Overrides de tema de la plataforma (servicio→servicio)",
        "tags": [
          "Usuarios (interno)"
        ]
      }
    },
    "/internal/empresas/capacidades": {
      "post": {
        "operationId": "InternalController_capacidadesDeEmpresas",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/VerificarCapacidadesRequestDto"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Capacidades encontradas"
          }
        },
        "security": [
          {
            "internalKey": []
          }
        ],
        "summary": "Capacidades activas por empresa (servicio→servicio)",
        "tags": [
          "Usuarios (interno)"
        ]
      }
    },
    "/internal/partes/{id}": {
      "get": {
        "operationId": "InternalController_parte",
        "parameters": [
          {
            "name": "id",
            "required": true,
            "in": "path",
            "description": "Id de la parte",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "empresa_id",
            "required": true,
            "in": "query",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Parte encontrada"
          }
        },
        "security": [
          {
            "internalKey": []
          }
        ],
        "summary": "Parte por id y empresa (servicio→servicio)",
        "tags": [
          "Usuarios (interno)"
        ]
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearer": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http"
      },
      "internalKey": {
        "type": "apiKey",
        "in": "header",
        "name": "x-internal-key"
      }
    },
    "schemas": {
      "ContarVendedoresResponseDto": {
        "type": "object",
        "properties": {
          "vendedores": {
            "type": "number",
            "description": "Cantidad de usuarios con rol vendedor",
            "example": 12
          }
        },
        "required": [
          "vendedores"
        ]
      },
      "EmpresaResponseDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "nombre": {
            "type": "string"
          },
          "vertical_id": {
            "type": "object",
            "nullable": true,
            "description": "Código dinámico de la vertical"
          },
          "pack_codigo": {
            "type": "object",
            "nullable": true,
            "description": "Código dinámico del pack"
          },
          "pack_version": {
            "type": "object",
            "nullable": true,
            "minimum": 1
          },
          "slug": {
            "type": "string",
            "description": "Slug público actual",
            "example": "distribuidora-piloto"
          },
          "modalidad_logistica": {
            "type": "string",
            "nullable": true,
            "enum": [
              "plataforma",
              "propia",
              "hibrida"
            ]
          },
          "tipo_empresa": {
            "type": "string",
            "enum": [
              "comercial",
              "logistica",
              "plataforma"
            ],
            "description": "Tipo de empresa; solo las comerciales tienen catálogo propio (ADR-27)"
          },
          "estado": {
            "type": "string"
          },
          "creado_por": {
            "type": "string",
            "format": "uuid"
          },
          "creado_en": {
            "type": "string"
          },
          "ruc": {
            "type": "object",
            "nullable": true
          },
          "razon_social": {
            "type": "string"
          },
          "nombre_comercial": {
            "type": "string"
          },
          "descripcion": {
            "type": "string"
          },
          "telefono": {
            "type": "string"
          },
          "correo_contacto": {
            "type": "string"
          },
          "sitio_web": {
            "type": "string"
          },
          "direccion": {
            "type": "string"
          },
          "ciudad": {
            "type": "string"
          },
          "departamento": {
            "type": "string"
          },
          "pais": {
            "type": "string"
          },
          "moneda": {
            "type": "string"
          },
          "zona_horaria": {
            "type": "string"
          },
          "sector": {
            "type": "string"
          },
          "representante_legal": {
            "type": "string"
          },
          "horario_atencion": {
            "type": "string"
          },
          "logo_objeto_id": {
            "type": "object",
            "nullable": true,
            "format": "uuid"
          },
          "logo_url": {
            "type": "object",
            "nullable": true,
            "description": "URL pública derivada del logo"
          },
          "background_objeto_id": {
            "type": "string",
            "nullable": true,
            "format": "uuid"
          },
          "background_media_type": {
            "type": "string",
            "nullable": true,
            "enum": [
              "imagen",
              "video"
            ]
          },
          "background_url": {
            "type": "string",
            "nullable": true,
            "description": "URL pública derivada del fondo"
          },
          "background_poster_objeto_id": {
            "type": "string",
            "nullable": true,
            "format": "uuid"
          },
          "background_poster_url": {
            "type": "string",
            "nullable": true,
            "description": "URL pública derivada del poster"
          },
          "background_alt": {
            "type": "string"
          },
          "background_overlay": {
            "type": "number",
            "minimum": 0,
            "maximum": 100
          },
          "background_position": {
            "type": "string",
            "enum": [
              "center",
              "top",
              "bottom",
              "left",
              "right"
            ]
          },
          "background_activo": {
            "type": "boolean"
          },
          "plantilla": {
            "type": "string",
            "enum": [
              "clasica",
              "minimal",
              "boutique",
              "mercado"
            ]
          },
          "tema": {
            "$ref": "#/components/schemas/TemaResponseDto"
          },
          "origen_personalizacion": {
            "$ref": "#/components/schemas/OrigenPersonalizacionResponseDto"
          },
          "actualizado_en": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "id",
          "nombre",
          "slug",
          "estado",
          "creado_por",
          "creado_en"
        ]
      },
      "OrigenPersonalizacionResponseDto": {
        "type": "object",
        "properties": {
          "plantilla": {
            "type": "string",
            "description": "Nivel que aportó la plantilla efectiva",
            "enum": [
              "tienda",
              "empresa",
              "plataforma",
              "defecto"
            ]
          },
          "tema": {
            "type": "string",
            "description": "Nivel más específico que aportó overrides de tema",
            "enum": [
              "tienda",
              "empresa",
              "plataforma",
              "defecto"
            ]
          }
        },
        "required": [
          "plantilla",
          "tema"
        ]
      },
      "TemaOverridesResponseDto": {
        "type": "object",
        "properties": {
          "plantilla_override": {
            "type": "string",
            "description": "Plantilla override o null si hereda",
            "enum": [
              "clasica",
              "minimal",
              "boutique",
              "mercado"
            ],
            "nullable": true
          },
          "tema_override": {
            "type": "object",
            "description": "Overrides parciales de tema",
            "additionalProperties": true
          }
        },
        "required": [
          "plantilla_override",
          "tema_override"
        ]
      },
      "TemaResponseDto": {
        "type": "object",
        "properties": {
          "color_primario": {
            "type": "string",
            "description": "Color primario (hex)",
            "example": "#1F2937"
          },
          "color_secundario": {
            "type": "string",
            "description": "Color secundario (hex)",
            "example": "#F59E0B"
          },
          "color_acento": {
            "type": "string",
            "description": "Color de acento (hex)",
            "example": "#10B981"
          },
          "color_fondo": {
            "type": "string",
            "description": "Color de fondo (hex)",
            "example": "#FFFFFF"
          },
          "color_texto": {
            "type": "string",
            "description": "Color de texto (hex)",
            "example": "#111827"
          },
          "fuente": {
            "type": "string",
            "description": "Fuente del tema",
            "enum": [
              "system",
              "inter",
              "poppins",
              "montserrat",
              "playfair"
            ],
            "example": "system"
          },
          "radio_bordes": {
            "type": "number",
            "description": "Radio de bordes en píxeles",
            "minimum": 0,
            "maximum": 32,
            "example": 12
          },
          "modo": {
            "type": "string",
            "description": "Modo de color",
            "enum": [
              "claro",
              "oscuro",
              "auto"
            ],
            "example": "claro"
          }
        },
        "required": [
          "color_primario",
          "color_secundario",
          "color_acento",
          "color_fondo",
          "color_texto",
          "fuente",
          "radio_bordes",
          "modo"
        ]
      },
      "UsuarioResponseDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "Id del usuario",
            "format": "uuid"
          },
          "nombre": {
            "type": "string",
            "description": "Nombre del usuario"
          },
          "correo": {
            "type": "string",
            "description": "Correo del usuario",
            "format": "email"
          },
          "rol": {
            "type": "string",
            "description": "Rol del usuario",
            "enum": [
              "admin",
              "vendedor",
              "comprador",
              "logistica",
              "coordinador",
              "supervisor",
              "operativo"
            ],
            "example": "vendedor"
          },
          "tenant_id": {
            "type": "string",
            "description": "Tenant del usuario",
            "format": "uuid"
          },
          "personal_id": {
            "type": "string",
            "description": "Ficha de personal vinculada",
            "format": "uuid"
          },
          "avatar_objeto_id": {
            "type": "object",
            "description": "Objeto de storage del avatar",
            "nullable": true,
            "format": "uuid"
          },
          "avatar_url": {
            "type": "object",
            "description": "URL pública del avatar",
            "nullable": true
          },
          "creado_en": {
            "type": "string",
            "description": "Fecha de creación (ISO 8601 UTC)",
            "format": "date-time"
          }
        },
        "required": [
          "id",
          "nombre",
          "correo",
          "rol",
          "creado_en"
        ]
      },
      "VerificarCapacidadesRequestDto": {
        "type": "object",
        "properties": {
          "empresa_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "format": "uuid"
            }
          },
          "capacidades": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "empresa_ids",
          "capacidades"
        ]
      }
    }
  }
}
