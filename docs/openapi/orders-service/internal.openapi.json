{
  "openapi": "3.0.0",
  "info": {
    "title": "Core Engine · orders-service · API interna",
    "description": "Contrato interno (/internal/**) de orders-service; requiere x-internal-key.",
    "version": "internal",
    "contact": {}
  },
  "x-servicio": "orders-service",
  "x-superficie": "interna",
  "security": [
    {
      "internalKey": []
    }
  ],
  "tags": [],
  "paths": {
    "/internal/pagos/webhook": {
      "post": {
        "operationId": "PagosController_webhookPago",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/WebhookPagoRequestDto"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Pago procesado por el proveedor",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/WebhookPagoResponseDto"
                }
              }
            }
          }
        },
        "security": [
          {
            "internalKey": []
          }
        ],
        "summary": "Webhook de proveedor de pagos (secreto compartido)",
        "tags": [
          "Pagos (interno)"
        ]
      }
    },
    "/internal/orders/{id}/transicion": {
      "post": {
        "operationId": "InternoController_transicion",
        "parameters": [
          {
            "name": "id",
            "required": true,
            "in": "path",
            "description": "Id de la orden",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "estado",
            "required": true,
            "in": "query",
            "description": "Estado objetivo",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "motivo",
            "required": false,
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "actor",
            "required": false,
            "in": "query",
            "description": "Usuario que ejecuta la transición",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "201": {
            "description": "Orden con el nuevo estado",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OrderViewResponseDto"
                }
              }
            }
          }
        },
        "security": [
          {
            "internalKey": []
          }
        ],
        "summary": "Avanzar el ciclo de vida de la orden (logística→orders)",
        "tags": [
          "Pedidos (interno)"
        ]
      }
    },
    "/internal/orders/{id}": {
      "get": {
        "operationId": "InternoController_orden",
        "parameters": [
          {
            "name": "id",
            "required": true,
            "in": "path",
            "description": "Id de la orden",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Orden encontrada",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OrderViewResponseDto"
                }
              }
            }
          }
        },
        "security": [
          {
            "internalKey": []
          }
        ],
        "summary": "Lectura completa de una orden (reportes/comisiones)",
        "tags": [
          "Pedidos (interno)"
        ]
      }
    },
    "/internal/orders": {
      "get": {
        "operationId": "InternoController_listar",
        "parameters": [
          {
            "name": "estado",
            "required": false,
            "in": "query",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Órdenes registradas",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/OrderViewResponseDto"
                  }
                }
              }
            }
          }
        },
        "security": [
          {
            "internalKey": []
          }
        ],
        "summary": "Listar órdenes (servicio→servicio)",
        "tags": [
          "Pedidos (interno)"
        ]
      }
    },
    "/internal/orders/{id}/reproyectar": {
      "post": {
        "operationId": "InternoController_reproyectar",
        "parameters": [
          {
            "name": "id",
            "required": true,
            "in": "path",
            "description": "Id de la orden",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "201": {
            "description": "Orden reproyectada",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OrderViewResponseDto"
                }
              }
            }
          }
        },
        "security": [
          {
            "internalKey": []
          }
        ],
        "summary": "Reproyectar una orden desde su historia (Event Sourcing)",
        "tags": [
          "Pedidos (interno)"
        ]
      }
    },
    "/internal/orders/{id}/historia": {
      "get": {
        "operationId": "InternoController_historia",
        "parameters": [
          {
            "name": "id",
            "required": true,
            "in": "path",
            "description": "Id de la orden",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Historia de eventos",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/HistoriaEventoResponseDto"
                  }
                }
              }
            }
          }
        },
        "security": [
          {
            "internalKey": []
          }
        ],
        "summary": "Historia inmutable de eventos de una orden",
        "tags": [
          "Pedidos (interno)"
        ]
      }
    },
    "/internal/orders/tenant/purgar": {
      "post": {
        "operationId": "orders_tenant_purgar",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "empresa_id"
                ],
                "properties": {
                  "empresa_id": {
                    "type": "string",
                    "format": "uuid"
                  },
                  "negocio_ids": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "format": "uuid"
                    }
                  },
                  "usuario_ids": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "format": "uuid"
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Purga aplicada",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true
                }
              }
            }
          }
        },
        "security": [
          {
            "internalKey": []
          }
        ],
        "summary": "Purgar/anonimizar datos del tenant",
        "tags": [
          "Tenant"
        ]
      }
    },
    "/internal/orders/tenant/exportar": {
      "post": {
        "operationId": "orders_tenant_exportar",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "empresa_id"
                ],
                "properties": {
                  "empresa_id": {
                    "type": "string",
                    "format": "uuid"
                  },
                  "negocio_ids": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "format": "uuid"
                    }
                  },
                  "usuario_ids": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "format": "uuid"
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Datos del tenant exportados",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true
                }
              }
            }
          }
        },
        "security": [
          {
            "internalKey": []
          }
        ],
        "summary": "Exportar datos del tenant",
        "tags": [
          "Tenant"
        ]
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearer": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http"
      },
      "internalKey": {
        "type": "apiKey",
        "in": "header",
        "name": "x-internal-key"
      }
    },
    "schemas": {
      "WebhookPagoRequestDto": {
        "type": "object",
        "properties": {
          "pago_id": {
            "type": "string",
            "format": "uuid"
          },
          "estado": {
            "type": "string",
            "enum": [
              "confirmado",
              "rechazado"
            ]
          },
          "motivo": {
            "type": "string"
          },
          "actor": {
            "type": "string",
            "format": "uuid"
          }
        },
        "required": [
          "pago_id",
          "estado"
        ]
      },
      "WebhookPagoResponseDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "order_id": {
            "type": "string",
            "format": "uuid"
          },
          "empresa_id": {
            "type": "string",
            "format": "uuid",
            "nullable": true
          },
          "metodo_codigo": {
            "type": "string"
          },
          "estado": {
            "type": "string"
          },
          "monto_cents": {
            "type": "integer"
          },
          "moneda": {
            "type": "string"
          },
          "referencia": {
            "type": "string"
          },
          "motivo_rechazo": {
            "type": "string"
          },
          "confirmado_por": {
            "type": "string",
            "format": "uuid",
            "nullable": true
          },
          "confirmado_en": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          },
          "creado_en": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "id",
          "order_id",
          "empresa_id",
          "metodo_codigo",
          "estado",
          "monto_cents",
          "moneda",
          "referencia",
          "motivo_rechazo",
          "confirmado_por",
          "confirmado_en",
          "creado_en"
        ]
      },
      "HistoriaEventoResponseDto": {
        "type": "object",
        "properties": {
          "event_id": {
            "type": "string",
            "description": "Id del evento",
            "format": "uuid"
          },
          "aggregate_id": {
            "type": "string",
            "description": "Id del agregado (orden)",
            "format": "uuid"
          },
          "tipo": {
            "type": "string",
            "description": "Tipo de evento",
            "example": "OrderCreatedEvent"
          },
          "payload": {
            "type": "object",
            "description": "Payload del evento"
          },
          "version": {
            "type": "number",
            "description": "Versión del agregado",
            "example": 1
          },
          "creado_en": {
            "type": "string",
            "description": "Fecha del evento (ISO 8601 UTC)",
            "format": "date-time"
          }
        },
        "required": [
          "event_id",
          "aggregate_id",
          "tipo",
          "payload",
          "version",
          "creado_en"
        ]
      },
      "ItemOrdenResponseDto": {
        "type": "object",
        "properties": {
          "oferta_id": {
            "type": "string",
            "description": "Id de la oferta",
            "format": "uuid"
          },
          "item_type": {
            "type": "string",
            "enum": [
              "producto",
              "servicio",
              "alquiler"
            ]
          },
          "item_id": {
            "type": "string",
            "format": "uuid"
          },
          "sku": {
            "type": "string",
            "description": "SKU del producto",
            "example": "SKU-001"
          },
          "producto_nombre": {
            "type": "string",
            "description": "Nombre del producto"
          },
          "cantidad": {
            "type": "number",
            "description": "Cantidad pedida",
            "example": 2
          },
          "precio_unitario_cents": {
            "type": "number",
            "description": "Precio unitario de venta en centavos",
            "example": 115000
          },
          "descuento_cents": {
            "type": "number",
            "description": "Descuento aplicado por promoción en centavos",
            "example": 0
          },
          "impuesto_cents": {
            "type": "integer",
            "description": "IVA de la línea en centavos"
          },
          "tasa_impuesto_bps": {
            "type": "integer",
            "description": "Tasa de IVA en puntos base"
          },
          "total_linea_cents": {
            "type": "integer",
            "description": "Total final de la línea"
          },
          "promocion_id": {
            "type": "string",
            "description": "Promoción aplicada a la línea",
            "format": "uuid",
            "nullable": true
          },
          "vendedor_id": {
            "type": "string",
            "description": "Id del vendedor; null en venta directa",
            "format": "uuid",
            "nullable": true
          },
          "tienda_id": {
            "type": "string",
            "description": "Id de la tienda",
            "format": "uuid"
          },
          "comision": {
            "type": "boolean",
            "description": "Indica si la línea genera comisión"
          },
          "ubicacion_id": {
            "type": "string",
            "description": "Bodega o sucursal desde la que se despacha la línea",
            "format": "uuid",
            "nullable": true
          },
          "fulfillment": {
            "type": "string",
            "enum": [
              "delivery",
              "pickup",
              "onsite",
              "none"
            ],
            "default": "none"
          },
          "fulfillment_config": {
            "type": "object",
            "additionalProperties": true
          }
        },
        "required": [
          "oferta_id",
          "item_type",
          "item_id",
          "sku",
          "producto_nombre",
          "cantidad",
          "precio_unitario_cents",
          "tienda_id"
        ]
      },
      "OrderViewResponseDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "Id de la orden",
            "format": "uuid"
          },
          "vendedor_id": {
            "type": "string",
            "description": "Id del vendedor; null en venta directa",
            "format": "uuid",
            "nullable": true
          },
          "comprador_id": {
            "type": "string",
            "description": "Id del comprador",
            "format": "uuid"
          },
          "parte_id": {
            "type": "object",
            "nullable": true,
            "format": "uuid",
            "description": "Referencia universal opcional del comprador"
          },
          "tienda_id": {
            "type": "string",
            "description": "Id de la tienda",
            "format": "uuid"
          },
          "estado": {
            "type": "string",
            "description": "Estado de la orden",
            "example": "pagada"
          },
          "tipo_orden": {
            "type": "string",
            "enum": [
              "compra",
              "reserva",
              "cotizacion",
              "orden_servicio"
            ]
          },
          "metodo_pago": {
            "type": "string",
            "enum": [
              "simulado",
              "credito"
            ],
            "example": "simulado"
          },
          "fulfillment_config": {
            "type": "object",
            "additionalProperties": true
          },
          "total_cents": {
            "type": "number",
            "description": "Total en centavos",
            "example": 230000
          },
          "impuesto_cents": {
            "type": "integer",
            "description": "IVA total de la orden en centavos"
          },
          "comision_cents": {
            "type": "number",
            "description": "Comisión en centavos",
            "example": 27600
          },
          "moneda": {
            "type": "string",
            "description": "Moneda",
            "example": "C$"
          },
          "items": {
            "description": "Líneas de la orden",
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ItemOrdenResponseDto"
            }
          },
          "direccion_envio": {
            "type": "object",
            "description": "Dirección de envío",
            "nullable": true
          },
          "creado_en": {
            "type": "string",
            "description": "Fecha de creación (ISO 8601 UTC)",
            "format": "date-time"
          },
          "actualizado_en": {
            "type": "string",
            "description": "Última actualización (ISO 8601 UTC)",
            "format": "date-time"
          },
          "pagada_en": {
            "type": "object",
            "description": "Fecha de pago (ISO 8601 UTC)",
            "nullable": true,
            "format": "date-time"
          },
          "enviada_en": {
            "type": "object",
            "description": "Fecha de envío (ISO 8601 UTC)",
            "nullable": true,
            "format": "date-time"
          },
          "entregada_en": {
            "type": "object",
            "description": "Fecha de entrega (ISO 8601 UTC)",
            "nullable": true,
            "format": "date-time"
          },
          "cancelada_en": {
            "type": "object",
            "description": "Fecha de cancelación (ISO 8601 UTC)",
            "nullable": true,
            "format": "date-time"
          },
          "devuelta_en": {
            "type": "object",
            "description": "Fecha de devolución (ISO 8601 UTC)",
            "nullable": true,
            "format": "date-time"
          },
          "cupon_codigo": {
            "type": "string",
            "description": "Código de cupón aplicado",
            "nullable": true
          },
          "descuento_cupon_cents": {
            "type": "integer",
            "description": "Descuento de cupón en centavos"
          }
        },
        "required": [
          "id",
          "comprador_id",
          "tienda_id",
          "estado",
          "tipo_orden",
          "metodo_pago",
          "total_cents",
          "comision_cents",
          "moneda",
          "items",
          "creado_en",
          "actualizado_en"
        ]
      }
    }
  }
}
