            }
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "Órdenes de una tienda (vendedor dueño, empresario de la empresa o admin)",
        "tags": [
          "Pedidos"
        ]
      }
    },
    "/api/v1/orders/empresa": {
      "get": {
        "operationId": "PedidosController_porEmpresa",
        "parameters": [
          {
            "name": "empresaId",
