              "type": "string"
            }
          },
          {
            "name": "tiendaId",
            "required": false,
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "estado",
            "required": false,
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "limite",
            "required": false,
            "in": "query",
            "schema": {
              "type": "number"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Órdenes de la empresa",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/OrderViewResponseDto"
                  }
                }
              }
            }
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "Órdenes de una empresa (empresario de la empresa o admin)",
        "tags": [
          "Pedidos"
        ]
      }
    },
    "/api/v1/orders/{id}": {
      "get": {
        "operationId": "PedidosController_detalle",
        "parameters": [
          {
            "name": "id",
            "required": true,
            "in": "path",
            "description": "Id de la orden",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Detalle de la orden",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OrderViewResponseDto"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "Estado/detalle de una orden (dueño o admin)",
        "tags": [
          "Pedidos"
        ]
      }
    },
    "/api/v1/orders/{id}/timeline": {
      "get": {
        "operationId": "PedidosController_timeline",
        "parameters": [
          {
            "name": "id",
            "required": true,
            "in": "path",
            "description": "Id de la orden",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Timeline de la orden",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/TimelineEventoResponseDto"
                  }
                }
              }
            }
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "Timeline de eventos de la orden (Event Sourcing)",
        "tags": [
          "Pedidos"
        ]
      }
    },
    "/api/v1/carrito": {
      "get": {
        "operationId": "CarritoController_ver",
        "parameters": [],
        "responses": {
          "200": {
            "description": "Carrito del comprador",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CarritoResponseDto"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "Ver el carrito del comprador (RN-05)",
        "tags": [
          "Carrito"
        ]
      },
      "delete": {
        "operationId": "CarritoController_vaciar",
        "parameters": [],
        "responses": {
          "200": {
            "description": "Carrito vacío",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CarritoResponseDto"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "Vaciar el carrito",
        "tags": [
          "Carrito"
        ]
      }
    },
    "/api/v1/carrito/items": {
      "post": {
        "operationId": "CarritoController_agregar",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AgregarItemRequestDto"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Item agregado",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CarritoResponseDto"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "Agregar un item al carrito",
        "tags": [
          "Carrito"
        ]
      }
    },
    "/api/v1/carrito/items/{ofertaId}": {
      "patch": {
        "operationId": "CarritoController_actualizar",
        "parameters": [
          {
            "name": "ofertaId",
            "required": true,
            "in": "path",
            "description": "Id de la oferta",
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ActualizarCantidadRequestDto"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Carrito actualizado",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CarritoResponseDto"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "Actualizar la cantidad de un item (0 lo elimina)",
        "tags": [
          "Carrito"
        ]
      },
      "delete": {
        "operationId": "CarritoController_quitar",
        "parameters": [
          {
            "name": "ofertaId",
            "required": true,
            "in": "path",
            "description": "Id de la oferta",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Carrito actualizado",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CarritoResponseDto"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "Quitar un item del carrito",
        "tags": [
          "Carrito"
        ]
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearer": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http"
      },
      "internalKey": {
        "type": "apiKey",
        "in": "header",
        "name": "x-internal-key"
      }
    },
    "schemas": {
      "ActualizarCantidadRequestDto": {
        "type": "object",
        "properties": {
          "cantidad": {
            "type": "number",
            "description": "Cantidad (0 elimina el item; 1-99)",
            "minimum": 0,
            "maximum": 99,
            "example": 3
          }
        },
        "required": [
          "cantidad"
        ]
      },
      "AgregarItemRequestDto": {
        "type": "object",
        "properties": {
          "oferta_id": {
            "type": "string",
            "description": "Id de la oferta (vendedor-producto)",
            "example": "a0eebc99-9c0b-4ef8-bb6d-6bb9bd380a11"
          },
          "cantidad": {
            "type": "number",
            "description": "Cantidad (1-99)",
            "minimum": 1,
            "maximum": 99,
            "example": 2
          }
        },
        "required": [
          "oferta_id",
          "cantidad"
        ]
      },
      "CarritoItemResponseDto": {
        "type": "object",
        "properties": {
          "oferta_id": {
            "type": "string",
            "description": "Id de la oferta",
            "format": "uuid"
          },
          "cantidad": {
            "type": "number",
            "description": "Cantidad",
            "example": 2
          },
          "id": {
            "type": "string",
            "description": "Id de la oferta (alias enriquecido)",
            "format": "uuid"
          },
          "tienda_id": {
            "type": "string",
            "description": "Id de la tienda",
            "format": "uuid"
          },
          "vendedor_id": {
            "type": "string",
            "description": "Id del vendedor",
            "format": "uuid"
          },
          "sku": {
            "type": "string",
            "description": "SKU del producto",
            "example": "SKU-001"
          },
          "producto_nombre": {
            "type": "string",
            "description": "Nombre del producto"
          },
          "precio_venta": {
            "type": "string",
            "description": "Precio de venta en córdobas con dos decimales",
            "example": "1150.00"
          },
          "stock": {
            "type": "number",
            "description": "Stock disponible",
            "example": 10
          },
          "estado": {
            "type": "string",
            "description": "Estado de la oferta",
            "example": "activa"
          }
        },
        "required": [
          "oferta_id",
          "cantidad",
          "id",
          "tienda_id",
          "vendedor_id",
          "sku",
          "producto_nombre",
          "precio_venta",
          "stock",
          "estado"
        ]
      },
      "CarritoResponseDto": {
        "type": "object",
        "properties": {
          "items": {
            "description": "Items del carrito",
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/CarritoItemResponseDto"
            }
          },
          "total": {
            "type": "string",
            "description": "Total del carrito en córdobas con dos decimales",
            "example": "2300.00"
          },
          "expira_en": {
            "type": "object",
            "description": "Expiración del carrito (ISO 8601 UTC); null si está vacío",
            "nullable": true,
            "format": "date-time"
          }
        },
        "required": [
          "items",
          "total"
        ]
      },
      "ComisionVistaResponseDto": {
        "type": "object",
        "properties": {
          "vendedor_id": {
            "type": "string",
            "description": "Id del vendedor",
            "format": "uuid"
          },
          "periodo": {
            "type": "string",
            "description": "Periodo (YYYY-MM)",
            "example": "2026-10"
          },
          "ordenes": {
            "type": "number",
            "description": "Órdenes del periodo",
            "example": 12
          },
          "total_ventas_cents": {
            "type": "number",
            "description": "Ventas del periodo en centavos",
            "example": 1380000
          },
          "total_comision_cents": {
            "type": "number",
            "description": "Comisiones del periodo en centavos",
            "example": 165600
          },
          "actualizado_en": {
            "type": "string",
            "description": "Última actualización (ISO 8601 UTC)",
            "format": "date-time"
          }
        },
        "required": [
          "vendedor_id",
          "periodo",
          "ordenes",
          "total_ventas_cents",
          "total_comision_cents",
          "actualizado_en"
        ]
      },
      "CreateOrderCommand": {
        "type": "object",
        "properties": {
          "items": {
            "description": "Artículos de la orden",
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ItemOrdenRequestDto"
            }
          },
          "usar_carrito": {
            "type": "boolean",
            "description": "Crear la orden desde el carrito (RN-05)",
            "example": false
          }
        }
      },
      "ItemOrdenRequestDto": {
        "type": "object",
        "properties": {
          "oferta_id": {
            "type": "string",
            "description": "Id de la oferta (vendedor-producto)"
          },
          "cantidad": {
            "type": "number",
            "description": "Cantidad (1-99)",
            "minimum": 1,
            "maximum": 99,
            "example": 1
          }
        },
        "required": [
          "oferta_id",
          "cantidad"
        ]
      },
      "ItemOrdenResponseDto": {
        "type": "object",
        "properties": {
          "oferta_id": {
            "type": "string",
            "description": "Id de la oferta",
            "format": "uuid"
          },
          "sku": {
            "type": "string",
            "description": "SKU del producto",
            "example": "SKU-001"
          },
          "producto_nombre": {
            "type": "string",
            "description": "Nombre del producto"
          },
          "cantidad": {
            "type": "number",
            "description": "Cantidad pedida",
            "example": 2
          },
          "precio_unitario_cents": {
            "type": "number",
            "description": "Precio unitario de venta en centavos",
            "example": 115000
          },
          "vendedor_id": {
            "type": "string",
            "description": "Id del vendedor",
            "format": "uuid"
          },
          "tienda_id": {
            "type": "string",
            "description": "Id de la tienda",
            "format": "uuid"
          }
        },
        "required": [
          "oferta_id",
          "sku",
          "producto_nombre",
          "cantidad",
          "precio_unitario_cents",
          "vendedor_id",
          "tienda_id"
        ]
      },
      "OrderViewResponseDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "Id de la orden",
            "format": "uuid"
          },
          "vendedor_id": {
            "type": "string",
            "description": "Id del vendedor",
            "format": "uuid"
          },
          "comprador_id": {
            "type": "string",
            "description": "Id del comprador",
            "format": "uuid"
          },
          "tienda_id": {
            "type": "string",
            "description": "Id de la tienda",
            "format": "uuid"
          },
          "estado": {
            "type": "string",
            "description": "Estado de la orden",
            "example": "pagada"
          },
          "total_cents": {
            "type": "number",
            "description": "Total en centavos",
            "example": 230000
          },
          "comision_cents": {
            "type": "number",
            "description": "Comisión en centavos",
            "example": 27600
          },
          "moneda": {
            "type": "string",
            "description": "Moneda",
            "example": "C$"
          },
          "items": {
            "description": "Líneas de la orden",
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ItemOrdenResponseDto"
            }
          },
          "direccion_envio": {
            "type": "object",
            "description": "Dirección de envío",
            "nullable": true
          },
          "creado_en": {
            "type": "string",
            "description": "Fecha de creación (ISO 8601 UTC)",
            "format": "date-time"
          },
          "actualizado_en": {
            "type": "string",
            "description": "Última actualización (ISO 8601 UTC)",
            "format": "date-time"
          },
          "pagada_en": {
            "type": "object",
            "description": "Fecha de pago (ISO 8601 UTC)",
            "nullable": true,
            "format": "date-time"
          },
          "enviada_en": {
            "type": "object",
            "description": "Fecha de envío (ISO 8601 UTC)",
            "nullable": true,
            "format": "date-time"
          },
          "entregada_en": {
            "type": "object",
            "description": "Fecha de entrega (ISO 8601 UTC)",
            "nullable": true,
            "format": "date-time"
          },
          "cancelada_en": {
            "type": "object",
            "description": "Fecha de cancelación (ISO 8601 UTC)",
            "nullable": true,
            "format": "date-time"
          },
          "devuelta_en": {
            "type": "object",
            "description": "Fecha de devolución (ISO 8601 UTC)",
            "nullable": true,
            "format": "date-time"
          }
        },
        "required": [
          "id",
          "vendedor_id",
          "comprador_id",
          "tienda_id",
          "estado",
          "total_cents",
          "comision_cents",
          "moneda",
          "items",
          "creado_en",
          "actualizado_en"
        ]
      },
      "TimelineEventoResponseDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "number",
            "description": "Secuencia del evento",
            "example": 3
          },
          "tipo": {
            "type": "string",
            "description": "Tipo de evento",
            "example": "OrderStatusUpdatedEvent"
          },
          "payload": {
            "type": "object",
            "description": "Payload del evento"
          },
          "version": {
            "type": "number",
            "description": "Versión del agregado",
            "example": 3
          },
          "creado_en": {
            "type": "string",
            "description": "Fecha del evento (ISO 8601 UTC)",
            "format": "date-time"
          }
        },
        "required": [
          "id",
          "tipo",
          "payload",
          "version",
          "creado_en"
        ]
      }
    }
  }
}
