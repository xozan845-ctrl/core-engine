              }
            }
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "Comisiones por periodo (vendedor/admin) — obsoleto: usar /vendedores/me/ventas",
        "tags": [
          "Pedidos"
        ]
      }
    },
    "/api/v1/orders/tienda/{tiendaId}": {
