{
  "openapi": "3.0.0",
  "info": {
    "title": "Core Engine · orders-service · API pública",
    "description": "Contrato público (/api/v1/**) de orders-service. No contiene rutas /internal/**.",
    "version": "v1",
    "contact": {}
  },
  "x-servicio": "orders-service",
