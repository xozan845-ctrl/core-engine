    "/api/v1/orders/vendedor/comisiones": {
      "get": {
        "deprecated": true,
        "operationId": "PedidosController_comisiones",
        "parameters": [
          {
            "name": "periodo",
            "required": false,
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "vendedorId",
