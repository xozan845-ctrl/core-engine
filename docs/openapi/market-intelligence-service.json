  "info": {
    "title": "Core Engine · market-intelligence-service",
    "description": "Inteligencia de mercado: métricas, mapa de calor y predicción (fuera de producción)",
    "version": "v1",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "securitySchemes": {
      "bearer": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http"
      }
    },
    "schemas": {
      "PuntoCalorDto": {
        "type": "object",
        "properties": {
          "lat": {
            "type": "number"
          },
          "lng": {
            "type": "number"
          },
          "peso": {
            "type": "number"
          },
          "tipo": {
            "type": "string"
          }
        },
        "required": [
          "lat",
          "lng",
          "peso",
          "tipo"
        ]
      },
      "MapaCalorResponseDto": {
        "type": "object",
        "properties": {
          "puntos": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/PuntoCalorDto"
            }
          },
          "total_puntos": {
            "type": "number"
          }
        },
        "required": [
          "puntos",
          "total_puntos"
        ]
      },
      "RendimientoVendedorResponseDto": {
        "type": "object",
        "properties": {
          "vendedor_id": {
            "type": "string",
            "description": "Id del vendedor",
            "format": "uuid"
          },
          "total_ventas": {
            "type": "number",
            "description": "Total de ventas",
            "example": 42
          },
          "total_monto_cents": {
            "type": "number",
            "description": "Monto total vendido en centavos",
            "example": 4830000
          },
          "ticket_promedio_cents": {
            "type": "number",
            "description": "Ticket promedio en centavos",
            "example": 115000
          },
          "pedidos_entregados": {
            "type": "number",
            "description": "Pedidos entregados",
            "example": 40
          },
          "tasa_efectividad": {
            "type": "number",
            "description": "Tasa de efectividad (0–1)",
            "example": 0.95
          },
          "actualizado_en": {
            "type": "string",
            "description": "Última actualización (ISO 8601 UTC)",
            "format": "date-time"
          }
        },
        "required": [
          "vendedor_id",
          "total_ventas",
          "total_monto_cents",
          "ticket_promedio_cents",
          "pedidos_entregados",
          "tasa_efectividad",
          "actualizado_en"
        ]
      },
      "PaginaRendimientoResponseDto": {
        "type": "object",
        "properties": {
          "data": {
            "description": "Rendimiento por vendedor",
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/RendimientoVendedorResponseDto"
            }
          },
          "next_cursor": {
            "type": "object",
            "description": "Cursor de la siguiente página",
            "nullable": true
          }
        },
        "required": [
          "data"
        ]
      },
      "CoberturaZonaResponseDto": {
        "type": "object",
        "properties": {
          "lat_cell": {
            "type": "number",
            "description": "Latitud de la celda",
            "example": 12.1364
          },
          "lng_cell": {
            "type": "number",
            "description": "Longitud de la celda",
            "example": -86.2514
          },
          "total_ventas": {
            "type": "number",
            "description": "Ventas en la celda",
            "example": 18
          },
          "total_monto_cents": {
            "type": "number",
            "description": "Monto vendido en centavos",
            "example": 2070000
          },
          "total_vendedores": {
            "type": "number",
            "description": "Vendedores activos en la celda",
            "example": 5
          },
          "actualizado_en": {
            "type": "string",
            "description": "Última actualización (ISO 8601 UTC)",
            "format": "date-time"
          },
          "geojson": {
            "type": "string",
            "description": "Bounding box en GeoJSON",
            "example": "{\"type\":\"Polygon\",\"coordinates\":[]}"
          }
        },
        "required": [
          "lat_cell",
          "lng_cell",
          "total_ventas",
          "total_monto_cents",
          "total_vendedores",
          "actualizado_en",
          "geojson"
        ]
      },
      "DemandaProductoResponseDto": {
        "type": "object",
        "properties": {
          "sku": {
            "type": "string",
            "description": "SKU del producto",
            "example": "SKU-001"
          },
          "nombre": {
            "type": "string",
            "description": "Nombre del producto"
          },
          "total_vendido": {
            "type": "number",
            "description": "Unidades vendidas",
            "example": 120
          },
          "total_monto_cents": {
            "type": "number",
            "description": "Monto vendido en centavos",
            "example": 13800000
          },
          "stock_actual": {
            "type": "number",
            "description": "Stock actual",
            "example": 10
          },
          "ultima_venta_en": {
            "type": "object",
            "description": "Última venta (ISO 8601 UTC)",
            "format": "date-time",
            "nullable": true
          },
          "actualizado_en": {
            "type": "string",
            "description": "Última actualización (ISO 8601 UTC)",
            "format": "date-time"
          }
        },
        "required": [
          "sku",
          "nombre",
          "total_vendido",
          "total_monto_cents",
          "stock_actual",
          "actualizado_en"
        ]
      },
      "PaginaDemandaResponseDto": {
        "type": "object",
        "properties": {
          "data": {
            "description": "Demanda por producto",
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/DemandaProductoResponseDto"
            }
          },
          "next_cursor": {
            "type": "object",
            "description": "Cursor de la siguiente página",
            "nullable": true
          }
        },
        "required": [
          "data"
        ]
      },
      "TendenciaResponseDto": {
        "type": "object",
        "properties": {
          "fecha": {
            "type": "string",
            "description": "Fecha de la tendencia",
            "format": "date"
          },
          "sku": {
            "type": "string",
            "description": "SKU del producto",
            "example": "SKU-001"
          },
          "vendedor_id": {
            "type": "string",
            "description": "Id del vendedor",
            "format": "uuid"
          },
          "total_ventas": {
            "type": "number",
            "description": "Unidades vendidas",
            "example": 12
          },
          "total_monto_cents": {
            "type": "number",
            "description": "Monto vendido en centavos",
            "example": 1380000
          },
          "dia_semana": {
            "type": "number",
            "description": "Día de la semana",
            "example": 3
          }
        },
        "required": [
          "fecha",
          "sku",
          "vendedor_id",
          "total_ventas",
          "total_monto_cents",
          "dia_semana"
        ]
      },
      "ResumenInteligenciaResponseDto": {
        "type": "object",
        "properties": {
          "total_pedidos": {
            "type": "number",
            "description": "Total de pedidos",
            "example": 320
          },
          "ingresos_totales_cents": {
            "type": "number",
            "description": "Ingresos totales en centavos",
            "example": 36800000
          },
          "vendedores_activos": {
            "type": "number",
            "description": "Vendedores activos",
            "example": 20
          },
          "calculado_en": {
            "type": "string",
            "description": "Fecha de cálculo (ISO 8601 UTC)",
            "format": "date-time"
          }
        },
        "required": [
          "total_pedidos",
          "ingresos_totales_cents",
          "vendedores_activos",
          "calculado_en"
        ]
      },
      "RegistrarVentaResponseDto": {
        "type": "object",
        "properties": {
          "codigo": {
            "type": "string",
            "description": "Código de resultado",
            "example": "OK"
          },
          "mensaje": {
            "type": "string",
            "description": "Mensaje de resultado",
            "example": "Venta registrada en inteligencia"
          }
        },
        "required": [
          "codigo",
          "mensaje"
        ]
      },
      "ForecastDemandaResponseDto": {
        "type": "object",
        "properties": {
          "sku": {
            "type": "string",
            "description": "SKU analizado",
            "example": "SKU-001"
          },
          "dias_proyectados": {
            "type": "number",
            "description": "Días proyectados",
            "example": 7
          },
          "ventas_proyectadas": {
            "type": "number",
            "description": "Ventas proyectadas",
            "example": 84
          },
          "intervalo_inferior": {
            "type": "number",
            "description": "Límite inferior del intervalo",
            "example": 60
          },
          "intervalo_superior": {
            "type": "number",
            "description": "Límite superior del intervalo",
            "example": 108
          },
          "avg_diario_base": {
            "type": "number",
            "description": "Media diaria base",
            "example": 12
          },
          "std_diario_base": {
            "type": "number",
            "description": "Desviación estándar diaria base",
            "example": 3.2
          },
          "features_computadas_en": {
            "type": "object",
            "description": "Fecha de cómputo de features",
            "nullable": true,
            "format": "date-time"
          },
          "metodologia": {
            "type": "string",
            "description": "Metodología aplicada",
            "example": "media_movil_ponderada_7d"
          }
        },
        "required": [
          "sku",
          "dias_proyectados",
          "ventas_proyectadas",
          "intervalo_inferior",
