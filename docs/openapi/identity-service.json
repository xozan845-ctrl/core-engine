{
  "openapi": "3.0.0",
  "paths": {
    "/internal/usuarios/{id}": {
      "get": {
        "operationId": "InternalController_usuario",
        "parameters": [
          {
            "name": "id",
            "required": true,
            "in": "path",
            "description": "Id del usuario",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Usuario encontrado",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UsuarioResponseDto"
                }
              }
            }
          }
        },
        "security": [
          {
            "internalKey": []
          }
        ],
        "summary": "Usuario por id (servicio→servicio)",
        "tags": [
          "Usuarios (interno)"
        ]
      }
    },
    "/internal/vendedores": {
      "get": {
        "operationId": "InternalController_vendedores",
        "parameters": [],
        "responses": {
          "200": {
            "description": "Vendedores registrados",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/UsuarioResponseDto"
                  }
                }
              }
            }
          }
        },
        "security": [
          {
            "internalKey": []
          }
        ],
        "summary": "Listar vendedores (servicio→servicio)",
        "tags": [
          "Usuarios (interno)"
        ]
      }
    },
    "/internal/contar-vendedores": {
      "get": {
        "operationId": "InternalController_contarVendedores",
        "parameters": [],
        "responses": {
          "200": {
            "description": "Conteo de vendedores",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ContarVendedoresResponseDto"
                }
              }
            }
          }
        },
        "security": [
          {
            "internalKey": []
          }
        ],
        "summary": "Contar vendedores (servicio→servicio)",
        "tags": [
          "Usuarios (interno)"
        ]
      }
    },
    "/api/v1/auth/registro": {
      "post": {
        "operationId": "AuthController_registrar",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RegistroRequestDto"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Sesión creada (JWT + refresh)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SesionResponseDto"
                }
              }
            }
          }
        },
        "summary": "Registrar vendedor o comprador",
        "tags": [
          "Auth"
        ]
      }
    },
    "/api/v1/auth/login": {
      "post": {
        "operationId": "AuthController_login",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginRequestDto"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Sesión iniciada",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SesionResponseDto"
                }
              }
            }
          },
          "401": {
            "description": "Credenciales inválidas"
          }
        },
        "summary": "Iniciar sesión (JWT + refresh)",
        "tags": [
          "Auth"
        ]
      }
    },
    "/api/v1/auth/refresh": {
      "post": {
        "operationId": "AuthController_refresh",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "refresh_token"
                ],
                "properties": {
                  "refresh_token": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Sesión renovada",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SesionResponseDto"
                }
              }
            }
          }
        },
        "summary": "Renovar la sesión con refresh token",
        "tags": [
          "Auth"
        ]
      }
    },
    "/api/v1/auth/logout": {
      "post": {
        "operationId": "AuthController_logout",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LogoutRequestDto"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Sesión cerrada",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OkResponseDto"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "Cerrar sesión (revoca el refresh token)",
        "tags": [
          "Auth"
        ]
      }
    },
    "/api/v1/auth/crear-usuario": {
      "post": {
        "operationId": "AuthController_crearUsuario",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CrearUsuarioRequestDto"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Usuario creado",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UsuarioResponseDto"
                }
              }
            }
          },
          "403": {
            "description": "Solo un administrador puede crear usuarios"
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "Crear usuario (solo admin)",
        "tags": [
          "Auth"
        ]
      }
    },
    "/api/v1/auth/cambiar-contrasena": {
      "post": {
        "operationId": "AuthController_cambiarContrasena",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CambiarContrasenaRequestDto"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Contraseña cambiada",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OkResponseDto"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "Cambiar la contraseña (autenticado)",
        "tags": [
          "Auth"
        ]
      }
    },
    "/api/v1/auth/restablecer-contrasena": {
      "post": {
        "operationId": "AuthController_restablecerContrasena",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RestablecerContrasenaRequestDto"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Solicitud aceptada",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OkResponseDto"
                }
              }
            }
          }
        },
        "summary": "Solicitar restablecimiento de contraseña (público)",
        "tags": [
          "Auth"
        ]
      }
    },
    "/api/v1/auth/me": {
      "get": {
        "operationId": "AuthController_yo",
        "parameters": [],
        "responses": {
          "200": {
            "description": "Contexto del usuario autenticado",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UsuarioContextoResponseDto"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "Perfil de la sesión actual",
        "tags": [
          "Auth"
        ]
      }
    },
    "/api/v1/auth/vincular-personal": {
      "post": {
        "operationId": "AuthController_vincularPersonal",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/VincularPersonalRequestDto"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Personal vinculado",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OkResponseDto"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "Vincular la ficha de personal del usuario autenticado",
        "tags": [
          "Auth"
        ]
      }
    },
    "/api/v1/usuarios": {
      "get": {
        "operationId": "UsuariosController_listar",
        "parameters": [],
        "responses": {
          "200": {
            "description": "Usuarios registrados",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/UsuarioResponseDto"
                  }
                }
              }
            }
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "Listar usuarios (admin)",
        "tags": [
          "Usuarios"
        ]
      }
    },
    "/api/v1/usuarios/{id}": {
      "get": {
        "operationId": "UsuariosController_obtener",
        "parameters": [
          {
            "name": "id",
            "required": true,
            "in": "path",
            "description": "Id del usuario",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Usuario encontrado",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UsuarioResponseDto"
                }
              }
            }
          },
          "404": {
            "description": "Usuario inexistente o sin permiso"
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "Perfil de un usuario (admin o el propio)",
        "tags": [
          "Usuarios"
        ]
      }
    }
  },
  "info": {
    "title": "Core Engine · identity-service",
    "description": "Autenticación, sesiones y usuarios (Tabla 21)",
    "version": "v1",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "securitySchemes": {
      "bearer": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http"
      },
      "internalKey": {
        "type": "apiKey",
        "in": "header",
        "name": "x-internal-key"
      }
    },
    "schemas": {
      "UsuarioResponseDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "Id del usuario",
            "format": "uuid"
          },
          "nombre": {
            "type": "string",
            "description": "Nombre del usuario"
          },
          "correo": {
            "type": "string",
            "description": "Correo del usuario",
            "format": "email"
          },
          "rol": {
            "type": "string",
            "description": "Rol del usuario",
            "enum": [
              "admin",
              "vendedor",
              "comprador",
              "logistica",
              "coordinador",
              "supervisor",
              "operativo"
            ],
            "example": "vendedor"
          },
          "tenant_id": {
            "type": "string",
            "description": "Tenant del usuario",
            "format": "uuid"
          },
          "personal_id": {
            "type": "string",
            "description": "Ficha de personal vinculada",
            "format": "uuid"
          },
          "creado_en": {
            "type": "string",
            "description": "Fecha de creación (ISO 8601 UTC)",
            "format": "date-time"
          }
        },
        "required": [
          "id",
          "nombre",
          "correo",
          "rol",
          "creado_en"
        ]
      },
      "ContarVendedoresResponseDto": {
        "type": "object",
        "properties": {
          "vendedores": {
            "type": "number",
            "description": "Cantidad de usuarios con rol vendedor",
            "example": 12
          }
        },
        "required": [
          "vendedores"
        ]
      },
      "RegistroRequestDto": {
        "type": "object",
        "properties": {
          "nombre": {
            "type": "string",
            "description": "Nombre completo",
            "minLength": 2,
            "maxLength": 120,
            "example": "Ana Pérez"
          },
          "correo": {
            "type": "string",
            "description": "Correo electrónico",
            "example": "ana@tienda.test"
          },
          "contrasena": {
            "type": "string",
            "description": "Contraseña (mínimo 8 caracteres)",
            "minLength": 8
          },
          "rol": {
            "type": "string",
            "description": "Rol registrable",
            "enum": [
              "vendedor",
              "comprador"
            ],
            "example": "comprador"
          }
        },
        "required": [
          "nombre",
          "correo",
          "contrasena",
          "rol"
        ]
      },
      "SesionUsuarioResponseDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "Id del usuario",
            "format": "uuid"
          },
          "nombre": {
            "type": "string",
            "description": "Nombre del usuario"
          },
          "correo": {
            "type": "string",
            "description": "Correo del usuario",
            "format": "email"
          },
          "rol": {
            "type": "string",
            "description": "Rol del usuario",
            "enum": [
              "admin",
              "vendedor",
              "comprador",
              "logistica",
              "coordinador",
              "supervisor",
              "operativo"
            ],
            "example": "comprador"
          },
          "tenant_id": {
            "type": "string",
            "description": "Tenant del usuario",
            "format": "uuid"
          },
          "personal_id": {
            "type": "string",
            "description": "Ficha de personal vinculada",
            "format": "uuid"
          }
        },
        "required": [
          "id",
          "nombre",
          "correo",
          "rol"
        ]
      },
      "SesionResponseDto": {
        "type": "object",
        "properties": {
          "access_token": {
            "type": "string",
            "description": "Access token JWT (HS256)",
            "example": "eyJhbGciOiJIUzI1NiIs..."
          },
          "refresh_token": {
            "type": "string",
            "description": "Refresh token JWT",
            "example": "eyJhbGciOiJIUzI1NiIs..."
          },
          "expira_en": {
            "type": "number",
            "description": "Vigencia del access token en segundos",
            "example": 900
          },
          "usuario": {
            "description": "Datos del usuario autenticado",
            "allOf": [
              {
                "$ref": "#/components/schemas/SesionUsuarioResponseDto"
              }
            ]
          }
        },
        "required": [
          "access_token",
          "refresh_token",
          "expira_en",
          "usuario"
        ]
      },
      "LoginRequestDto": {
        "type": "object",
        "properties": {
          "correo": {
            "type": "string",
            "description": "Correo electrónico",
            "example": "ana@tienda.test"
          },
          "contrasena": {
            "type": "string",
            "description": "Contraseña",
            "example": "secreto123"
          }
        },
        "required": [
          "correo",
          "contrasena"
        ]
      },
      "LogoutRequestDto": {
        "type": "object",
        "properties": {
          "refresh_token": {
            "type": "string",
            "description": "Refresh token de la sesión a cerrar; si se omite, cierra todas"
          }
        }
      },
      "OkResponseDto": {
        "type": "object",
        "properties": {
          "ok": {
            "type": "boolean",
            "description": "Operación completada",
            "example": true
          }
        },
        "required": [
          "ok"
        ]
      },
      "CrearUsuarioRequestDto": {
        "type": "object",
        "properties": {
          "nombre": {
            "type": "string",
            "description": "Nombre completo",
            "minLength": 2,
            "maxLength": 120
          },
          "correo": {
            "type": "string",
            "description": "Correo electrónico"
          },
          "contrasena": {
            "type": "string",
            "description": "Contraseña (mínimo 8 caracteres)",
            "minLength": 8
          },
          "rol": {
            "type": "string",
            "description": "Rol del usuario",
            "enum": [
              "vendedor",
              "comprador",
              "admin",
              "logistica",
              "coordinador",
              "supervisor",
              "operativo"
            ]
          },
          "tenant_id": {
            "type": "string",
            "description": "Tenant (organización); obligatorio para roles de logística"
          },
          "personal_id": {
            "type": "string",
            "description": "Id de la ficha de personal en field-service"
          }
        },
        "required": [
          "nombre",
          "correo",
          "contrasena",
          "rol"
        ]
      },
      "CambiarContrasenaRequestDto": {
        "type": "object",
        "properties": {
          "actual": {
            "type": "string",
            "description": "Contraseña actual"
          },
          "nueva": {
            "type": "string",
            "description": "Contraseña nueva (mínimo 8 caracteres)",
            "minLength": 8
          }
        },
        "required": [
          "actual",
          "nueva"
        ]
      },
      "RestablecerContrasenaRequestDto": {
        "type": "object",
        "properties": {
          "correo": {
            "type": "string",
            "description": "Correo electrónico de la cuenta"
          }
        },
        "required": [
          "correo"
        ]
      },
      "UsuarioContextoResponseDto": {
        "type": "object",
        "properties": {
          "user_id": {
            "type": "string",
            "description": "Id del usuario autenticado",
            "format": "uuid"
          },
          "email": {
            "type": "string",
            "description": "Correo del usuario",
            "format": "email"
          },
          "rol": {
            "type": "string",
            "description": "Rol del usuario",
            "enum": [
              "admin",
              "vendedor",
              "comprador",
              "logistica",
              "coordinador",
              "supervisor",
              "operativo"
            ],
            "example": "admin"
          },
          "nombre": {
            "type": "string",
            "description": "Nombre del usuario"
          },
          "tenant_id": {
            "type": "string",
            "description": "Tenant del usuario",
            "format": "uuid"
          },
          "personal_id": {
            "type": "string",
            "description": "Ficha de personal vinculada",
            "format": "uuid"
          }
        },
        "required": [
          "user_id",
          "email",
          "rol"
        ]
      },
      "VincularPersonalRequestDto": {
        "type": "object",
        "properties": {
          "personal_id": {
            "type": "string",
            "description": "Id de la ficha de personal en field-service",
            "minLength": 1,
            "maxLength": 100
          },
          "nombre": {
            "type": "string",
            "description": "Nombre a reflejar en el perfil",
            "maxLength": 120
          }
        },
        "required": [
          "personal_id"
        ]
      }
    }
  }
}
