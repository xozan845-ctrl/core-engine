{
  "openapi": "3.1.0",
  "info": {
    "title": "inventory-service (interno)",
    "version": "1.0.9",
    "description": "Superficie interna de inventario para orders, stores y commissions."
  },
  "x-servicio": "inventory-service",
  "x-superficie": "interna",
  "servers": [
    {
      "url": "http://inventory-service:3013"
    }
  ],
  "security": [
    {
      "internalKey": []
    }
  ],
  "paths": {
    "/internal/inventario/resumen": {
      "get": {
        "summary": "Resumen de inventario",
        "parameters": [
          {
            "name": "empresa_id",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Resumen",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "403": {
            "description": "Clave interna invalida"
          }
        },
        "security": [
          {
            "internalKey": []
          }
        ]
      }
    },
    "/internal/inventario/lineas": {
      "get": {
        "summary": "Lineas de inventario",
        "parameters": [
          {
            "name": "empresa_id",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Lineas",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "403": {
            "description": "Clave interna invalida"
          }
        },
        "security": [
          {
            "internalKey": []
          }
        ]
      }
    },
    "/internal/inventario/stock": {
      "post": {
        "operationId": "InternalController_stockLote",
        "summary": "Stock y series disponibles por lote de SKUs (servicio a servicio)",
        "tags": [
          "Inventario (interno)"
        ],
        "security": [
          {
            "internalKey": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "empresa_id": {
                    "type": "string",
                    "format": "uuid"
                  },
                  "skus": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  }
                },
                "required": [
                  "empresa_id",
                  "skus"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Stock por SKU",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/StockInternoLineaDto"
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "internalKey": {
        "type": "apiKey",
        "in": "header",
        "name": "x-internal-key"
      }
    },
    "schemas": {
      "StockInternoLineaDto": {
        "type": "object",
        "properties": {
          "item_id": {
            "type": "string",
            "format": "uuid"
          },
          "empresa_id": {
            "type": "string",
            "format": "uuid"
          },
          "sku": {
            "type": "string"
          },
          "track_serial": {
            "type": "boolean"
          },
          "estado": {
            "type": "string"
          },
          "stock": {
            "type": "number"
          },
          "seriales_disponibles": {
            "type": "number"
          }
        },
        "required": [
          "empresa_id",
          "sku",
          "stock",
          "track_serial",
          "seriales_disponibles",
          "estado"
        ]
      }
    }
  }
}
