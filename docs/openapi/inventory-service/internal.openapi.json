{
  "openapi": "3.1.0",
  "info": {
    "title": "inventory-service (interno)",
    "version": "1.0.9",
    "description": "Superficie interna de inventario para orders, stores y commissions."
  },
  "x-servicio": "inventory-service",
  "x-superficie": "interna",
  "servers": [
    {
      "url": "http://inventory-service:3013"
    }
  ],
  "security": [
    {
      "internalKey": []
    }
  ],
  "paths": {
    "/internal/inventario/resumen": {
      "get": {
        "summary": "Resumen de inventario",
        "parameters": [
          {
            "name": "empresa_id",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Resumen",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "403": {
            "description": "Clave interna invalida"
          }
        },
        "security": [
          {
            "internalKey": []
          }
        ]
      }
    },
    "/internal/inventario/lineas": {
      "get": {
        "summary": "Lineas de inventario",
        "parameters": [
          {
            "name": "empresa_id",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Lineas",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "403": {
            "description": "Clave interna invalida"
          }
        },
        "security": [
          {
            "internalKey": []
          }
        ]
      }
    },
    "/internal/inventario/stock": {
      "post": {
        "operationId": "InternalController_stockLote",
        "summary": "Stock y series disponibles por lote de SKUs (servicio a servicio)",
        "tags": [
          "Inventario (interno)"
        ],
        "security": [
          {
            "internalKey": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "empresa_id": {
                    "type": "string",
                    "format": "uuid"
                  },
                  "skus": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "ubicacion_id": {
                    "type": "string",
                    "format": "uuid",
                    "nullable": true,
                    "description": "Acota el stock y los seriales a una ubicación"
                  }
                },
                "required": [
                  "empresa_id",
                  "skus"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Stock por SKU",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/StockInternoLineaDto"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/internal/inventario/stock/inicial": {
      "post": {
        "operationId": "InternalController_stockInicial",
        "summary": "Registra el stock inicial de un item (servicio a servicio)",
        "tags": [
          "Inventario (interno)"
        ],
        "security": [
          {
            "internalKey": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "empresa_id": {
                    "type": "string",
                    "format": "uuid"
                  },
                  "item_id": {
                    "type": "string",
                    "format": "uuid"
                  },
                  "sku": {
                    "type": "string"
                  },
                  "cantidad": {
                    "type": "number",
                    "minimum": 0
                  },
                  "negocio_id": {
                    "type": "string",
                    "format": "uuid",
                    "nullable": true
                  }
                },
                "required": [
                  "empresa_id",
                  "item_id",
                  "cantidad"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Stock inicial registrado",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "item_id": {
                      "type": "string",
                      "format": "uuid"
                    },
                    "sku": {
                      "type": "string"
                    },
                    "stock": {
                      "type": "number"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/internal/inventario/devolucion": {
      "post": {
        "operationId": "InternalController_devolucion",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "order_id": {
                    "type": "string",
                    "format": "uuid"
                  },
                  "devolucion_id": {
                    "type": "string",
                    "format": "uuid"
                  },
                  "items": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "empresa_id": {
                          "type": "string",
                          "format": "uuid"
                        },
                        "sku": {
                          "type": "string"
                        },
                        "cantidad": {
                          "type": "integer"
                        },
                        "ubicacion_id": {
                          "type": "string",
                          "format": "uuid",
                          "nullable": true
                        }
                      },
                      "required": [
                        "empresa_id",
                        "sku",
                        "cantidad"
                      ]
                    }
                  }
                },
                "required": [
                  "order_id",
                  "devolucion_id",
                  "items"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Stock reintegrado",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "ok": {
                      "type": "boolean"
                    }
                  },
                  "required": [
                    "ok"
                  ]
                }
              }
            }
          }
        },
        "security": [
          {
            "internalKey": []
          }
        ],
        "summary": "Reintegrar stock de una devolución parcial",
        "tags": [
          "Inventario (interno)"
        ]
      }
    },
    "/internal/inventory/tenant/exportar": {
      "post": {
        "operationId": "inventory_tenant_exportar",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "empresa_id"
                ],
                "properties": {
                  "empresa_id": {
                    "type": "string",
                    "format": "uuid"
                  },
                  "negocio_ids": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "format": "uuid"
                    }
                  },
                  "usuario_ids": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "format": "uuid"
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Datos del tenant exportados",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true
                }
              }
            }
          }
        },
        "security": [
          {
            "internalKey": []
          }
        ],
        "summary": "Exportar datos del tenant",
        "tags": [
          "Tenant"
        ]
      }
    },
    "/internal/inventory/tenant/purgar": {
      "post": {
        "operationId": "inventory_tenant_purgar",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "empresa_id"
                ],
                "properties": {
                  "empresa_id": {
                    "type": "string",
                    "format": "uuid"
                  },
                  "negocio_ids": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "format": "uuid"
                    }
                  },
                  "usuario_ids": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "format": "uuid"
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Purga aplicada",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true
                }
              }
            }
          }
        },
        "security": [
          {
            "internalKey": []
          }
        ],
        "summary": "Purgar/anonimizar datos del tenant",
        "tags": [
          "Tenant"
        ]
      }
    }
  },
  "components": {
    "securitySchemes": {
      "internalKey": {
        "type": "apiKey",
        "in": "header",
        "name": "x-internal-key"
      }
    },
    "schemas": {
      "StockInternoLineaDto": {
        "type": "object",
        "properties": {
          "item_id": {
            "type": "string",
            "format": "uuid"
          },
          "empresa_id": {
            "type": "string",
            "format": "uuid"
          },
          "sku": {
            "type": "string"
          },
          "track_serial": {
            "type": "boolean"
          },
          "estado": {
            "type": "string"
          },
          "stock": {
            "type": "number"
          },
          "seriales_disponibles": {
            "type": "number"
          }
        },
        "required": [
          "empresa_id",
          "sku",
          "stock",
          "track_serial",
          "seriales_disponibles",
          "estado"
        ]
      }
    }
  }
}
