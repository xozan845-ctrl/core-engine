            "example": 12
          },
          "productos": {
            "type": "number",
            "description": "Productos en catálogo",
            "example": 20
          },
          "stock_total": {
            "type": "number",
            "description": "Unidades en stock",
            "example": 120
          },
          "agotados": {
            "type": "number",
            "description": "Productos agotados",
            "example": 2
          },
          "devoluciones_mes": {
            "type": "number",
