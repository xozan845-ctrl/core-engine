  "components": {
    "securitySchemes": {
      "bearer": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http"
      }
    },
    "schemas": {
      "EstadoCuentaEmpresaResponseDto": {
        "type": "object",
        "properties": {
          "empresa_id": {
            "type": "string",
            "description": "Id de la empresa",
            "format": "uuid"
          },
          "ventas": {
            "description": "Ventas de la empresa",
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/VentaEmpresaResponseDto"
            }
          },
          "comisiones_pendientes": {
            "type": "string",
            "description": "Comisiones pendientes en córdobas",
            "example": "126.00"
          },
          "liquidaciones": {
            "description": "Liquidaciones de la empresa",
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/LiquidacionEmpresaConMontoResponseDto"
            }
          }
        },
        "required": [
          "empresa_id",
          "ventas",
          "comisiones_pendientes",
          "liquidaciones"
        ]
      },
      "EstadoCuentaResponseDto": {
        "type": "object",
        "properties": {
          "vendedor_id": {
            "type": "string",
            "description": "Id del vendedor",
            "format": "uuid"
          },
          "ventas": {
            "description": "Ventas del vendedor",
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/VentaVendedorResponseDto"
            }
          },
          "comisiones_pendientes": {
            "type": "string",
            "description": "Comisiones pendientes en córdobas",
            "example": "138.00"
          },
          "liquidaciones": {
            "description": "Liquidaciones del vendedor",
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/LiquidacionConMontoResponseDto"
            }
          }
        },
        "required": [
          "vendedor_id",
          "ventas",
          "comisiones_pendientes",
          "liquidaciones"
        ]
      },
      "LiquidacionConMontoResponseDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "Id de la liquidación",
            "format": "uuid"
          },
          "vendedor_id": {
            "type": "string",
            "description": "Id del vendedor",
            "format": "uuid"
          },
          "periodo_inicio": {
            "type": "string",
            "description": "Inicio del periodo (ISO 8601)",
            "format": "date"
          },
          "periodo_fin": {
            "type": "string",
            "description": "Fin del periodo (ISO 8601)",
            "format": "date"
          },
          "monto_cents": {
            "type": "number",
            "description": "Monto liquidado en centavos",
            "example": 13800
          },
          "estado": {
            "type": "string",
            "description": "Estado de la liquidación",
            "enum": [
              "aprobada",
              "pagada"
            ],
            "example": "aprobada"
          },
          "creado_en": {
            "type": "string",
            "description": "Fecha de creación (ISO 8601 UTC)",
            "format": "date-time"
          },
          "monto": {
            "type": "string",
            "description": "Monto liquidado en córdobas con dos decimales",
            "example": "138.00"
          }
        },
        "required": [
          "id",
          "vendedor_id",
          "periodo_inicio",
          "periodo_fin",
          "monto_cents",
          "estado",
          "creado_en",
          "monto"
        ]
      },
