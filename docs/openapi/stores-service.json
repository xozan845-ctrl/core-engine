{
  "openapi": "3.0.0",
  "paths": {
    "/internal/ofertas": {
      "get": {
        "operationId": "InternalController_porIds",
        "parameters": [
          {
            "name": "ids",
            "required": false,
            "in": "query",
            "description": "Ids de oferta separados por coma",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Ofertas encontradas",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/OfertaResponseDto"
                  }
                }
              }
            }
          }
        },
        "security": [
          {
            "internalKey": []
          }
        ],
        "summary": "Lote de ofertas por ids (servicio→servicio)",
        "tags": [
          "Tiendas (interno)"
        ]
      }
    },
    "/api/v1/vendedores/tienda": {
      "post": {
        "operationId": "TiendasController_crear",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CrearTiendaRequestDto"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Tienda creada",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TiendaResponseDto"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "Crear la tienda del vendedor autenticado",
        "tags": [
          "Tiendas"
        ]
      }
    },
    "/api/v1/vendedores/me/tienda": {
      "get": {
        "operationId": "TiendasController_miTienda",
        "parameters": [],
        "responses": {
          "200": {
            "description": "Tienda del vendedor",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TiendaResponseDto"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "Tienda del vendedor autenticado",
        "tags": [
          "Tiendas"
        ]
      }
    },
    "/api/v1/vendedores/productos": {
      "post": {
        "operationId": "OfertasController_publicar",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PublicarProductoRequestDto"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Oferta creada",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OfertaResponseDto"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "Publicar un producto con margen (vendedor)",
        "tags": [
          "Tiendas"
        ]
      }
    },
    "/api/v1/vendedores/productos/{id}": {
      "patch": {
        "operationId": "OfertasController_cambiarMargen",
        "parameters": [
          {
            "name": "id",
            "required": true,
            "in": "path",
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CambiarMargenRequestDto"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Oferta actualizada",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OfertaResponseDto"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "Cambiar el margen de una oferta (vendedor)",
        "tags": [
          "Tiendas"
        ]
      }
    },
    "/api/v1/vendedores/me/ofertas": {
      "get": {
        "operationId": "OfertasController_misOfertas",
        "parameters": [],
        "responses": {
          "200": {
            "description": "Página de ofertas",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PaginaOfertasResponseDto"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "Listar las ofertas del vendedor autenticado",
        "tags": [
          "Tiendas"
        ]
      }
    },
    "/api/v1/tiendas/{id}": {
      "get": {
        "operationId": "OfertasController_tiendaPublica",
        "parameters": [
          {
            "name": "id",
            "required": true,
            "in": "path",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Tienda con sus ofertas",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TiendaPublicaResponseDto"
                }
              }
            }
          },
          "404": {
            "description": "Tienda inexistente (NO_ENCONTRADO)"
          }
        },
        "summary": "Tienda pública con sus ofertas (ruta pública)",
        "tags": [
          "Tiendas"
        ]
      }
    }
  },
  "info": {
    "title": "Core Engine · stores-service",
    "description": "Tiendas de vendedores: ofertas, precio final y estado (Tabla 21)",
    "version": "v1",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "securitySchemes": {
      "bearer": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http"
      },
      "internalKey": {
        "type": "apiKey",
        "in": "header",
        "name": "x-internal-key"
      }
    },
    "schemas": {
      "OfertaResponseDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "Id de la oferta",
            "format": "uuid"
          },
          "tienda_id": {
            "type": "string",
            "description": "Id de la tienda",
            "format": "uuid"
          },
          "vendedor_id": {
            "type": "string",
            "description": "Id del vendedor",
            "format": "uuid"
          },
          "producto_id": {
            "type": "string",
            "description": "Id del producto maestro",
            "format": "uuid"
          },
          "sku": {
            "type": "string",
            "description": "SKU del producto",
            "example": "SKU-001"
          },
          "producto_nombre": {
            "type": "string",
            "description": "Nombre del producto"
          },
          "margen": {
            "type": "number",
            "description": "Margen aplicado (0–90)",
            "example": 15
          },
          "precio_base": {
            "type": "string",
            "description": "Precio base en córdobas con dos decimales",
            "example": "1000.00"
          },
          "precio_venta": {
            "type": "string",
            "description": "Precio de venta en córdobas con dos decimales",
            "example": "1150.00"
          },
          "stock": {
            "type": "number",
            "description": "Stock disponible",
            "example": 10
          },
          "estado": {
            "type": "string",
            "description": "Estado de la oferta",
            "example": "activa"
          },
          "creado_en": {
            "type": "string",
            "description": "Fecha de creación (ISO 8601 UTC)",
            "format": "date-time"
          }
        },
        "required": [
          "id",
          "tienda_id",
          "vendedor_id",
          "producto_id",
          "sku",
          "producto_nombre",
          "margen",
          "precio_base",
          "precio_venta",
          "stock",
          "estado",
          "creado_en"
        ]
      },
      "CrearTiendaRequestDto": {
        "type": "object",
        "properties": {
          "nombre": {
            "type": "string",
            "description": "Nombre de la tienda",
            "minLength": 2,
            "maxLength": 100,
            "example": "Mi tienda"
          },
          "descripcion": {
            "type": "string",
            "description": "Descripción de la tienda",
            "example": "Ropa y accesorios"
          }
        },
        "required": [
          "nombre"
        ]
      },
      "TiendaResponseDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "Id de la tienda",
            "format": "uuid"
          },
          "vendedor_id": {
            "type": "string",
            "description": "Id del vendedor dueño",
            "format": "uuid"
          },
          "nombre": {
            "type": "string",
            "description": "Nombre de la tienda",
            "example": "Mi tienda"
          },
          "descripcion": {
            "type": "string",
            "description": "Descripción de la tienda"
          },
          "creado_en": {
            "type": "string",
            "description": "Fecha de creación (ISO 8601 UTC)",
            "format": "date-time"
          }
        },
        "required": [
          "id",
          "vendedor_id",
          "nombre",
          "descripcion",
          "creado_en"
        ]
      },
      "PublicarProductoRequestDto": {
        "type": "object",
        "properties": {
          "producto_id": {
            "type": "string",
            "description": "Id del producto a publicar",
            "example": "a0eebc99-9c0b-4ef8-bb6d-6bb9bd380a11"
          },
          "margen": {
            "type": "number",
            "description": "Margen en enteros (15 = 15 %). RN-01: 0 a 90",
            "minimum": 0,
            "maximum": 90,
            "example": 15
          }
        },
        "required": [
          "producto_id",
          "margen"
        ]
      },
      "CambiarMargenRequestDto": {
        "type": "object",
        "properties": {
          "margen": {
            "type": "number",
            "description": "Nuevo margen en enteros (0 a 90)",
            "minimum": 0,
            "maximum": 90,
            "example": 20
          }
        },
        "required": [
          "margen"
        ]
      },
      "PaginaOfertasResponseDto": {
        "type": "object",
        "properties": {
          "items": {
            "description": "Ofertas de la página",
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/OfertaResponseDto"
            }
          },
          "total": {
            "type": "number",
            "description": "Total de ofertas",
            "example": 42
          },
          "pagina": {
            "type": "number",
            "description": "Página actual (1-based)",
            "example": 1
          },
          "limite": {
            "type": "number",
            "description": "Tamaño de página",
            "example": 20
          },
          "paginas": {
            "type": "number",
            "description": "Total de páginas",
            "example": 3
          }
        },
        "required": [
          "items",
          "total",
          "pagina",
          "limite",
          "paginas"
        ]
      },
      "TiendaPublicaResponseDto": {
        "type": "object",
        "properties": {
          "tienda": {
            "description": "Datos de la tienda",
            "allOf": [
              {
                "$ref": "#/components/schemas/TiendaResponseDto"
              }
            ]
          },
          "ofertas": {
            "description": "Ofertas de la tienda",
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/OfertaResponseDto"
            }
          }
        },
        "required": [
          "tienda",
          "ofertas"
        ]
      }
    }
  }
}
