{
  "openapi": "3.0.0",
  "info": {
    "title": "Core Engine · finance-service · API interna",
    "description": "Contrato interno (/internal/**) de finance-service; requiere x-internal-key.",
    "version": "internal",
    "contact": {}
  },
  "x-servicio": "finance-service",
  "x-superficie": "interna",
  "security": [
    {
      "internalKey": []
    }
  ],
  "tags": [],
  "paths": {
    "/internal/finance/sujetos/{usuarioId}": {
      "get": {
        "operationId": "InternoController_sujeto",
        "parameters": [
          {
            "name": "usuarioId",
            "required": true,
            "in": "path",
            "description": "Id del usuario",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Sujeto fiscal del usuario",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SujetoTributarioResponseDto"
                }
              }
            }
          }
        },
        "security": [
          {
            "internalKey": []
          }
        ],
        "summary": "Situación fiscal de un usuario (para identity)",
        "tags": [
          "Finanzas (interno)"
        ]
      }
    },
    "/internal/finance/declaraciones": {
      "get": {
        "operationId": "InternoController_declaraciones",
        "parameters": [
          {
            "name": "tipo",
            "required": false,
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "periodo_inicio",
            "required": false,
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "estado",
            "required": false,
            "in": "query",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Declaraciones del periodo",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/DeclaracionResponseDto"
                  }
                }
              }
            }
          }
        },
        "security": [
          {
            "internalKey": []
          }
        ],
        "summary": "Declaraciones del periodo (reportes)",
        "tags": [
          "Finanzas (interno)"
        ]
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearer": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http"
      },
      "internalKey": {
        "type": "apiKey",
        "in": "header",
        "name": "x-internal-key"
      }
    },
    "schemas": {
      "DeclaracionResponseDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "Id de la declaración",
            "format": "uuid"
          },
          "jurisdiccion": {
            "type": "string",
            "description": "Jurisdicción",
            "example": "NI"
          },
          "tipo": {
            "type": "string",
            "description": "Tipo",
            "enum": [
              "IVA",
              "IR",
              "CUOTA_FIJA"
            ],
            "example": "IVA"
          },
          "periodo_inicio": {
            "type": "string",
            "description": "Inicio del periodo",
            "format": "date"
          },
          "periodo_fin": {
            "type": "string",
            "description": "Fin del periodo",
            "format": "date"
          },
          "base_gravada_cents": {
            "type": "number",
            "description": "Base gravada en centavos",
            "example": 1150000
          },
          "iva_debitado_cents": {
            "type": "number",
            "description": "IVA debitado en centavos",
            "example": 172500
          },
          "iva_credito_cents": {
            "type": "number",
            "description": "IVA crédito en centavos",
            "example": 0
          },
          "iva_a_pagar_cents": {
            "type": "number",
            "description": "IVA a pagar en centavos",
            "example": 172500
          },
          "renta_bruta_cents": {
            "type": "number",
            "description": "Renta bruta en centavos",
            "example": 1150000
          },
          "renta_gravable_cents": {
            "type": "number",
            "description": "Renta gravable en centavos",
            "example": 575000
          },
          "ir_a_pagar_cents": {
            "type": "number",
            "description": "IR a pagar en centavos",
            "example": 172500
          },
          "cuota_cents": {
            "type": "number",
            "description": "Cuota fija en centavos",
            "example": 5000
          },
          "estado": {
            "type": "string",
            "description": "Estado",
            "enum": [
              "PENDIENTE",
              "GENERADA",
              "PRESENTADA",
              "PAGADA",
              "CANCELADA"
            ],
            "example": "GENERADA"
          },
          "detalle": {
            "type": "object",
            "description": "Detalle de la declaración",
            "nullable": true
          },
          "generada_en": {
            "type": "string",
            "description": "Fecha de generación",
            "format": "date-time"
          },
          "presentada_en": {
            "type": "string",
            "description": "Fecha de presentación",
            "format": "date-time"
          },
          "creado_en": {
            "type": "string",
            "description": "Fecha de creación (ISO 8601 UTC)",
            "format": "date-time"
          }
        },
        "required": [
          "id",
          "jurisdiccion",
          "tipo",
          "periodo_inicio",
          "periodo_fin",
          "base_gravada_cents",
          "iva_debitado_cents",
          "iva_credito_cents",
          "iva_a_pagar_cents",
          "renta_bruta_cents",
          "renta_gravable_cents",
          "ir_a_pagar_cents",
          "cuota_cents",
          "estado",
          "creado_en"
        ]
      },
      "SujetoTributarioResponseDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "Id del sujeto",
            "format": "uuid"
          },
          "jurisdiccion": {
            "type": "string",
            "description": "Jurisdicción",
            "example": "NI"
          },
          "regimen_id": {
            "type": "string",
            "description": "Id del régimen",
            "format": "uuid"
          },
          "regimen_nombre": {
            "type": "string",
            "description": "Nombre del régimen"
          },
          "razon_social": {
            "type": "string",
            "description": "Razón social"
          },
          "ruc": {
            "type": "string",
            "description": "RUC"
          },
          "es_plataforma": {
            "type": "boolean",
            "description": "¿Es la plataforma?",
            "example": false
          },
          "estado": {
            "type": "string",
            "description": "Estado",
            "enum": [
              "ACTIVO",
              "BAJA"
            ],
            "example": "ACTIVO"
          },
          "creado_en": {
            "type": "string",
            "description": "Fecha de creación (ISO 8601 UTC)",
            "format": "date-time"
          }
        },
        "required": [
          "id",
          "jurisdiccion",
          "razon_social",
          "es_plataforma",
          "estado",
          "creado_en"
        ]
      }
    }
  }
}
