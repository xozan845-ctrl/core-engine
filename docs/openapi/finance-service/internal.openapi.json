{
  "openapi": "3.0.0",
  "info": {
    "title": "Core Engine · finance-service · API interna",
    "description": "Contrato interno (/internal/**) de finance-service; requiere x-internal-key.",
    "version": "internal",
    "contact": {}
  },
  "x-servicio": "finance-service",
  "x-superficie": "interna",
  "security": [
    {
      "internalKey": []
    }
  ],
  "tags": [],
  "paths": {
    "/internal/finance/sujetos/{usuarioId}": {
      "get": {
        "operationId": "InternoController_sujeto",
        "parameters": [
          {
            "name": "usuarioId",
            "required": true,
            "in": "path",
            "description": "Id del usuario",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Sujeto fiscal del usuario",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SujetoTributarioResponseDto"
                }
              }
            }
          }
        },
        "security": [
          {
            "internalKey": []
          }
        ],
        "summary": "Situación fiscal de un usuario (para identity)",
        "tags": [
          "Finanzas (interno)"
        ]
      }
    },
    "/internal/finance/configuracion-fiscal": {
      "get": {
        "operationId": "InternoController_configuracionFiscal",
        "parameters": [
          {
            "name": "empresa_id",
            "required": true,
            "in": "query",
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "negocio_id",
            "required": false,
            "in": "query",
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Configuración fiscal efectiva",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "empresa_id": {
                      "type": "string",
                      "format": "uuid"
                    },
                    "negocio_id": {
                      "type": "string",
                      "format": "uuid",
                      "nullable": true
                    },
                    "jurisdiccion": {
                      "type": "string"
                    },
                    "moneda": {
                      "type": "string"
                    },
                    "tasa_iva": {
                      "type": "number"
                    },
                    "impuesto_activo": {
                      "type": "boolean"
                    },
                    "precios_con_impuesto": {
                      "type": "boolean"
                    }
                  }
                }
              }
            }
          }
        },
        "security": [
          {
            "internalKey": []
          }
        ],
        "summary": "Configuración fiscal efectiva para checkout",
        "tags": [
          "Finanzas (interno)"
        ]
      }
    },
    "/internal/finance/notas-credito": {
      "post": {
        "operationId": "InternoController_notaCredito",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "orden_id",
                  "devolucion_id",
                  "empresa_id",
                  "base_cents",
                  "iva_cents",
                  "total_cents"
                ],
                "properties": {
                  "orden_id": {
                    "type": "string",
                    "format": "uuid"
                  },
                  "devolucion_id": {
                    "type": "string",
                    "format": "uuid"
                  },
                  "empresa_id": {
                    "type": "string",
                    "format": "uuid"
                  },
                  "negocio_id": {
                    "type": "string",
                    "format": "uuid",
                    "nullable": true
                  },
                  "parte_id": {
                    "type": "string",
                    "format": "uuid",
                    "nullable": true
                  },
                  "base_cents": {
                    "type": "integer"
                  },
                  "iva_cents": {
                    "type": "integer"
                  },
                  "total_cents": {
                    "type": "integer"
                  },
                  "moneda": {
                    "type": "string"
                  },
                  "items": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "additionalProperties": true
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Nota de crédito emitida",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true
                }
              }
            }
          }
        },
        "security": [
          {
            "internalKey": []
          }
        ],
        "summary": "Emitir nota de crédito parcial (servicio→servicio)",
        "tags": [
          "Finanzas (interno)"
        ]
      }
    },
    "/internal/finance/tipos-cambio": {
      "get": {
        "operationId": "InternoController_tipoCambio",
        "parameters": [
          {
            "name": "base",
            "required": true,
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "quote",
            "required": true,
            "in": "query",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Tasa vigente",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TipoCambioInternoResponseDto"
                }
              }
            }
          }
        },
        "security": [
          {
            "internalKey": []
          }
        ],
        "summary": "Tipo de cambio vigente (servicio→servicio)",
        "tags": [
          "Finanzas (interno)"
        ]
      }
    },
    "/internal/finance/creditos": {
      "post": {
        "operationId": "InternoController_registrarCredito",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RegistrarCreditoInternoRequestDto"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Crédito registrado",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CreditoOrdenResponseDto"
                }
              }
            }
          }
        },
        "security": [
          {
            "internalKey": []
          }
        ],
        "summary": "Registrar una venta a crédito desde orders",
        "tags": [
          "Finanzas (interno)"
        ]
      }
    },
    "/internal/finance/creditos/orden/{orderId}": {
      "delete": {
        "operationId": "InternoController_anularCredito",
        "parameters": [
          {
            "name": "orderId",
            "required": true,
            "in": "path",
            "schema": {
              "format": "uuid",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Crédito anulado"
          }
        },
        "security": [
          {
            "internalKey": []
          }
        ],
        "summary": "Anular el crédito ligado a una orden no creada",
        "tags": [
          "Finanzas (interno)"
        ]
      }
    },
    "/internal/finance/declaraciones": {
      "get": {
        "operationId": "InternoController_declaraciones",
        "parameters": [
          {
            "name": "tipo",
            "required": false,
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "periodo_inicio",
            "required": false,
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "estado",
            "required": false,
            "in": "query",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Declaraciones del periodo",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/DeclaracionResponseDto"
                  }
                }
              }
            }
          }
        },
        "security": [
          {
            "internalKey": []
          }
        ],
        "summary": "Declaraciones del periodo (reportes)",
        "tags": [
          "Finanzas (interno)"
        ]
      }
    },
    "/internal/finance/tenant/purgar": {
      "post": {
        "operationId": "finance_tenant_purgar",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "empresa_id"
                ],
                "properties": {
                  "empresa_id": {
                    "type": "string",
                    "format": "uuid"
                  },
                  "negocio_ids": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "format": "uuid"
                    }
                  },
                  "usuario_ids": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "format": "uuid"
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Purga aplicada",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true
                }
              }
            }
          }
        },
        "security": [
          {
            "internalKey": []
          }
        ],
        "summary": "Purgar/anonimizar datos del tenant",
        "tags": [
          "Tenant"
        ]
      }
    },
    "/internal/finance/tenant/exportar": {
      "post": {
        "operationId": "finance_tenant_exportar",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "empresa_id"
                ],
                "properties": {
                  "empresa_id": {
                    "type": "string",
                    "format": "uuid"
                  },
                  "negocio_ids": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "format": "uuid"
                    }
                  },
                  "usuario_ids": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "format": "uuid"
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Datos del tenant exportados",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true
                }
              }
            }
          }
        },
        "security": [
          {
            "internalKey": []
          }
        ],
        "summary": "Exportar datos del tenant",
        "tags": [
          "Tenant"
        ]
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearer": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http"
      },
      "internalKey": {
        "type": "apiKey",
        "in": "header",
        "name": "x-internal-key"
      }
    },
    "schemas": {
      "CreditoOrdenResponseDto": {
        "type": "object",
        "properties": {
          "credito_id": {
            "type": "string",
            "format": "uuid"
          },
          "balance_cents": {
            "type": "number"
          },
          "limite_cents": {
            "type": "number"
          }
        },
        "required": [
          "credito_id",
          "balance_cents",
          "limite_cents"
        ]
      },
      "DeclaracionResponseDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "Id de la declaración",
            "format": "uuid"
          },
          "jurisdiccion": {
            "type": "string",
            "description": "Jurisdicción",
            "example": "NI"
          },
          "tipo": {
            "type": "string",
            "description": "Tipo",
            "enum": [
              "IVA",
              "IR",
              "CUOTA_FIJA"
            ],
            "example": "IVA"
          },
          "periodo_inicio": {
            "type": "string",
            "description": "Inicio del periodo",
            "format": "date"
          },
          "periodo_fin": {
            "type": "string",
            "description": "Fin del periodo",
            "format": "date"
          },
          "base_gravada_cents": {
            "type": "number",
            "description": "Base gravada en centavos",
            "example": 1150000
          },
          "iva_debitado_cents": {
            "type": "number",
            "description": "IVA debitado en centavos",
            "example": 172500
          },
          "iva_credito_cents": {
            "type": "number",
            "description": "IVA crédito en centavos",
            "example": 0
          },
          "iva_a_pagar_cents": {
            "type": "number",
            "description": "IVA a pagar en centavos",
            "example": 172500
          },
          "renta_bruta_cents": {
            "type": "number",
            "description": "Renta bruta en centavos",
            "example": 1150000
          },
          "renta_gravable_cents": {
            "type": "number",
            "description": "Renta gravable en centavos",
            "example": 575000
          },
          "ir_a_pagar_cents": {
            "type": "number",
            "description": "IR a pagar en centavos",
            "example": 172500
          },
          "cuota_cents": {
            "type": "number",
            "description": "Cuota fija en centavos",
            "example": 5000
          },
          "estado": {
            "type": "string",
            "description": "Estado",
            "enum": [
              "PENDIENTE",
              "GENERADA",
              "PRESENTADA",
              "PAGADA",
              "CANCELADA"
            ],
            "example": "GENERADA"
          },
          "detalle": {
            "type": "object",
            "description": "Detalle de la declaración",
            "nullable": true
          },
          "generada_en": {
            "type": "string",
            "description": "Fecha de generación",
            "format": "date-time"
          },
          "presentada_en": {
            "type": "string",
            "description": "Fecha de presentación",
            "format": "date-time"
          },
          "creado_en": {
            "type": "string",
            "description": "Fecha de creación (ISO 8601 UTC)",
            "format": "date-time"
          }
        },
        "required": [
          "id",
          "jurisdiccion",
          "tipo",
          "periodo_inicio",
          "periodo_fin",
          "base_gravada_cents",
          "iva_debitado_cents",
          "iva_credito_cents",
          "iva_a_pagar_cents",
          "renta_bruta_cents",
          "renta_gravable_cents",
          "ir_a_pagar_cents",
          "cuota_cents",
          "estado",
          "creado_en"
        ]
      },
      "RegistrarCreditoInternoRequestDto": {
        "type": "object",
        "properties": {
          "empresa_id": {
            "type": "string",
            "format": "uuid"
          },
          "parte_id": {
            "type": "string",
            "format": "uuid"
          },
          "order_id": {
            "type": "string",
            "format": "uuid"
          },
          "monto_cents": {
            "type": "number",
            "minimum": 1
          },
          "concepto": {
            "type": "string",
            "minLength": 1
          },
          "vendedor_id": {
            "type": "string",
            "format": "uuid"
          }
        },
        "required": [
          "empresa_id",
          "parte_id",
          "order_id",
          "monto_cents",
          "concepto"
        ]
      },
      "TipoCambioInternoResponseDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "base": {
            "type": "string"
          },
          "quote": {
            "type": "string"
          },
          "tasa": {
            "type": "string"
          },
          "vigente_desde": {
            "type": "string",
            "format": "date-time"
          },
          "creado_por": {
            "type": "string",
            "format": "uuid"
          },
          "creado_en": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "id",
          "base",
          "quote",
          "tasa",
          "vigente_desde",
          "creado_por",
          "creado_en"
        ]
      },
      "SujetoTributarioResponseDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "Id del sujeto",
            "format": "uuid"
          },
          "jurisdiccion": {
            "type": "string",
            "description": "Jurisdicción",
            "example": "NI"
          },
          "regimen_id": {
            "type": "string",
            "description": "Id del régimen",
            "format": "uuid"
          },
          "regimen_nombre": {
            "type": "string",
            "description": "Nombre del régimen"
          },
          "razon_social": {
            "type": "string",
            "description": "Razón social"
          },
          "ruc": {
            "type": "string",
            "description": "RUC"
          },
          "es_plataforma": {
            "type": "boolean",
            "description": "¿Es la plataforma?",
            "example": false
          },
          "estado": {
            "type": "string",
            "description": "Estado",
            "enum": [
              "ACTIVO",
              "BAJA"
            ],
            "example": "ACTIVO"
          },
          "creado_en": {
            "type": "string",
            "description": "Fecha de creación (ISO 8601 UTC)",
            "format": "date-time"
          }
        },
        "required": [
          "id",
          "jurisdiccion",
          "razon_social",
          "es_plataforma",
          "estado",
          "creado_en"
        ]
      }
    }
  }
}
