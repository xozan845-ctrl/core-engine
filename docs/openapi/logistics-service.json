{
  "openapi": "3.0.0",
  "paths": {
    "/api/v1/orders/{id}/estado": {
      "patch": {
        "operationId": "EstadoOrdenController_avanzar",
        "parameters": [
          {
            "name": "id",
            "required": true,
            "in": "path",
            "description": "Id de la orden",
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AvanzarEstadoRequestDto"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Orden con el nuevo estado",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OrdenExternaResponseDto"
                }
              }
            }
          },
          "400": {
            "description": "Estado objetivo inválido (ESTADO_INVALIDO)"
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "Avanzar el estado de una orden (logística)",
        "tags": [
          "Logística"
        ]
      }
    },
    "/api/v1/admin/envios": {
      "get": {
        "operationId": "EnviosAdminController_listar",
        "parameters": [],
        "responses": {
          "200": {
            "description": "Guías de despacho con monto serializado",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/EnvioConMontoResponseDto"
                  }
                }
              }
            }
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "Listar guías de despacho (admin)",
        "tags": [
          "Logística"
        ]
      }
    }
  },
  "info": {
    "title": "Core Engine · logistics-service",
    "description": "Logística y envíos — ciclo de vida de la orden y guías de despacho (Tabla 21)",
    "version": "v1",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "securitySchemes": {
      "bearer": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http"
      }
    },
    "schemas": {
      "AvanzarEstadoRequestDto": {
        "type": "object",
        "properties": {
          "estado": {
            "type": "string",
            "description": "Estado objetivo del ciclo de vida de la orden",
            "enum": [
              "en_preparacion",
              "enviada",
              "entregada",
              "cancelada",
              "devuelta"
            ],
            "example": "enviada"
          },
          "motivo": {
            "type": "string",
            "description": "Motivo del cambio de estado",
            "example": "despacho a ruta 3"
          }
        },
        "required": [
          "estado"
        ]
      },
      "ItemOrdenExternaResponseDto": {
        "type": "object",
        "properties": {
          "sku": {
            "type": "string",
            "description": "SKU del producto",
            "example": "SKU-001"
          },
          "cantidad": {
            "type": "number",
            "description": "Cantidad pedida",
            "example": 2
          },
          "producto_nombre": {
            "type": "string",
            "description": "Nombre del producto"
          }
        },
        "required": [
          "sku",
          "cantidad",
          "producto_nombre"
        ]
      },
      "OrdenExternaResponseDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "Id de la orden",
            "format": "uuid"
          },
          "cliente_id": {
            "type": "string",
            "description": "Id del comprador",
            "format": "uuid"
          },
          "items": {
            "description": "Líneas de la orden",
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ItemOrdenExternaResponseDto"
            }
          },
          "total": {
            "type": "string",
            "description": "Total en córdobas con dos decimales",
            "example": "1150.00"
          },
          "total_cents": {
            "type": "number",
            "description": "Total en centavos",
            "example": 115000
          },
          "estado": {
            "type": "string",
            "description": "Estado actual de la orden",
            "example": "enviada"
          }
        },
        "required": [
          "id",
          "cliente_id",
          "items",
          "total",
          "total_cents",
          "estado"
        ]
      },
      "EnvioConMontoResponseDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "Id de la guía de despacho",
            "format": "uuid"
          },
          "guia": {
            "type": "string",
            "description": "Número de guía",
            "example": "BGH-ABC123-DEF456"
          },
          "order_id": {
            "type": "string",
            "description": "Id de la orden asociada",
            "format": "uuid"
          },
          "estado": {
            "type": "string",
            "description": "Estado del envío",
            "example": "en_preparacion"
          },
          "creado_en": {
            "type": "string",
            "description": "Fecha de creación (ISO 8601 UTC)",
            "format": "date-time"
          },
          "monto": {
            "type": "string",
            "description": "Monto del envío en córdobas con dos decimales",
            "example": "1150.00"
          }
        },
        "required": [
          "id",
          "guia",
          "order_id",
          "estado",
          "creado_en",
          "monto"
        ]
      }
    }
  }
}
