  "info": {
    "title": "Core Engine · catalog-service",
    "description": "Catálogo maestro y control de stock (Tabla 21)",
    "version": "v1",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "securitySchemes": {
      "bearer": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http"
      }
    },
    "schemas": {
      "CrearProductoRequestDto": {
        "type": "object",
        "properties": {
          "sku": {
            "type": "string",
            "description": "SKU del producto",
            "pattern": "^[A-Za-z0-9-]{2,32}$",
            "example": "SKU-001"
          },
          "nombre": {
            "type": "string",
            "description": "Nombre del producto",
            "minLength": 2,
            "maxLength": 200
          },
          "descripcion": {
            "type": "string",
            "description": "Descripción"
          },
          "categoria": {
            "type": "string",
            "description": "Categoría"
          },
          "precio_base": {
            "type": "string",
            "description": "Precio base decimal (ej: 1000.00) en córdobas; se guarda en centavos",
            "example": "1000.00"
          },
          "stock": {
            "type": "number",
            "description": "Stock inicial",
            "minimum": 0,
            "example": 10
          }
        },
        "required": [
          "sku",
          "nombre",
          "precio_base",
          "stock"
        ]
      },
      "ActualizarProductoRequestDto": {
        "type": "object",
        "properties": {
          "nombre": {
            "type": "string",
            "description": "Nombre del producto",
            "minLength": 2,
            "maxLength": 200
          },
          "descripcion": {
            "type": "string",
            "description": "Descripción"
          },
          "categoria": {
            "type": "string",
            "description": "Categoría"
          },
          "precio_base": {
            "type": "string",
            "description": "Precio base decimal (ej: 1000.00)"
          },
          "stock": {
            "type": "number",
            "description": "Stock",
            "minimum": 0
          },
          "motivo": {
            "type": "string",
            "description": "Motivo del cambio (RN-08 histórico)"
          }
        }
      }
    }
  }
}
