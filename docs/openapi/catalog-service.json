  "info": {
    "title": "Core Engine · catalog-service",
    "description": "Catálogo maestro y control de stock (Tabla 21)",
    "version": "v1",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "securitySchemes": {
      "bearer": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http"
      },
      "internalKey": {
        "type": "apiKey",
        "in": "header",
        "name": "x-internal-key"
      }
    },
    "schemas": {
      "LoteProductoResponseDto": {
        "type": "object",
        "properties": {
          "empresa_id": {
            "type": "string",
            "description": "Empresa dueña del producto",
            "format": "uuid"
          },
          "sku": {
            "type": "string",
            "description": "SKU del producto (único por empresa)",
            "example": "SKU-001"
          },
          "stock": {
            "type": "number",
            "description": "Stock disponible",
            "example": 10
          },
          "estado": {
            "type": "string",
            "description": "Estado del producto",
            "enum": [
              "disponible",
              "agotado"
            ],
            "example": "disponible"
          }
        },
        "required": [
          "sku",
          "stock",
          "estado"
        ]
      },
      "ImagenProductoResponseDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "Id de la relación producto-imagen",
            "format": "uuid"
          },
          "objeto_id": {
            "type": "string",
            "description": "Id del objeto en storage-service",
            "format": "uuid"
          },
          "url": {
            "type": "string",
            "description": "Ruta pública relativa servida por storage-service",
            "example": "/api/v1/storage/public/objetos/8f0c..."
          },
          "orden": {
            "type": "number",
            "description": "Orden de la imagen (0-2)",
            "minimum": 0,
            "maximum": 2
          },
          "es_principal": {
            "type": "boolean",
            "description": "Imagen principal del producto/variante"
          }
        },
        "required": [
          "id",
          "objeto_id",
          "url",
          "orden",
          "es_principal"
        ]
      },
      "VarianteProductoResponseDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "Id de la variante",
            "format": "uuid"
          },
          "producto_padre_id": {
            "type": "string",
            "description": "Id del producto padre",
            "format": "uuid"
          },
          "sku": {
            "type": "string",
            "description": "SKU de la variante",
            "example": "SKU-001-ROJO-M"
          },
          "nombre": {
            "type": "string",
            "description": "Nombre visible de la variante"
          },
          "atributos": {
            "type": "object",
            "description": "Atributos de la variante (color, talla, etc.)",
            "additionalProperties": true
          },
          "precio_base": {
            "type": "string",
            "description": "Precio base en córdobas con dos decimales",
            "example": "1500.00"
          },
          "stock": {
            "type": "number",
            "description": "Stock disponible",
            "example": 10
          },
          "estado": {
            "type": "string",
            "description": "Estado de la variante",
            "enum": [
              "disponible",
              "agotado"
            ]
          },
          "imagenes": {
            "description": "Imágenes de la variante (máx. 3)",
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ImagenProductoResponseDto"
            }
          },
          "creado_en": {
            "type": "string",
            "description": "Fecha de creación (ISO 8601 UTC)",
            "format": "date-time"
          }
        },
        "required": [
          "id",
          "producto_padre_id",
          "sku",
          "nombre",
          "atributos",
          "precio_base",
          "stock",
          "estado",
          "imagenes",
          "creado_en"
        ]
      },
      "ProductoResponseDto": {
        "type": "object",
        "properties": {
          "empresa_id": {
            "type": "string",
            "description": "Empresa propietaria",
            "format": "uuid"
          },
          "id": {
            "type": "string",
            "description": "Id del producto",
            "format": "uuid"
          },
          "sku": {
            "type": "string",
            "description": "SKU del producto (único por empresa)",
            "example": "SKU-001"
          },
          "nombre": {
            "type": "string",
            "description": "Nombre del producto"
          },
          "descripcion": {
            "type": "string",
            "description": "Descripción del producto"
          },
          "categoria": {
            "type": "string",
            "description": "Categoría del producto"
          },
          "precio_base": {
            "type": "string",
            "description": "Precio base en córdobas con dos decimales",
            "example": "1000.00"
          },
          "stock": {
            "type": "number",
            "description": "Stock disponible (neto de reservas)",
            "example": 10
          },
          "estado": {
            "type": "string",
            "description": "Estado del producto",
            "enum": [
              "disponible",
              "agotado"
            ],
            "example": "disponible"
          },
          "creado_en": {
            "type": "string",
            "description": "Fecha de creación (ISO 8601 UTC)",
            "format": "date-time"
          },
          "producto_padre_id": {
            "type": "object",
            "description": "Producto padre si esta fila es una variante",
            "nullable": true,
            "format": "uuid"
          },
          "atributos": {
            "type": "object",
            "description": "Atributos de la variante (color, talla, etc.)",
            "additionalProperties": true
          },
          "tiene_variantes": {
            "type": "boolean",
            "description": "El producto tiene variantes vendibles"
          },
          "imagenes": {
            "description": "Imágenes del producto (máx. 3)",
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ImagenProductoResponseDto"
            }
          },
          "variantes": {
            "description": "Variantes (solo en el detalle del padre)",
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/VarianteProductoResponseDto"
            }
          },
          "precio_desde": {
            "type": "string",
            "description": "Precio mínimo mostrable (\"desde\")",
            "example": "1000.00"
          },
          "stock_total": {
            "type": "number",
            "description": "Stock agregado de las variantes o el propio",
            "example": 25
          }
        },
        "required": [
          "empresa_id",
          "id",
          "sku",
          "nombre",
          "descripcion",
          "categoria",
          "precio_base",
          "stock",
          "estado",
          "creado_en"
        ]
      },
      "ResumenInventarioResponseDto": {
        "type": "object",
        "properties": {
          "productos": {
            "type": "number",
            "description": "Total de productos",
            "example": 20
          },
          "agotados": {
            "type": "number",
            "description": "Productos agotados",
            "example": 2
          },
          "stock_total": {
            "type": "number",
            "description": "Unidades en stock",
            "example": 120
          },
          "valor_inventario_cents": {
            "type": "number",
            "description": "Valor del inventario en centavos",
            "example": 12000000
          }
        },
        "required": [
          "productos",
          "agotados",
          "stock_total",
          "valor_inventario_cents"
        ]
      },
      "LineaInventarioResponseDto": {
        "type": "object",
        "properties": {
          "empresa_id": {
            "type": "string",
            "description": "Empresa dueña del producto (ADR-27)",
            "format": "uuid"
          },
          "sku": {
            "type": "string",
