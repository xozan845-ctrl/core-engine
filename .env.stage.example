# ── Core Engine · Variables de STAGE (plantilla) ──────────────────────────
# En local: copia este archivo a `.env.stage` (NO se versiona; ver .gitignore) y
# rellena cada valor. En Dockploy, pega estas variables en la pestaña
# *Environment* del environment `staging`: Dockploy las escribe a `.env`, el
# archivo que el compose consume por defecto (`ENV_FILE`, R-CD-7).
# Los secretos se inyectan en runtime, nunca en la imagen (R-CD-7).
#
# Mismos servicios que producción; valores ÚNICOS de stage (no reutilizar los de
# producción). La BD de stage es una base de datos aparte del mismo Postgres
# (aislamiento lógico, R-CD-9).

# Postgres de stage (base de datos dedicada, no compartir con producción)
POSTGRES_HOST=<CAMBIAR host de la BD de stage>
POSTGRES_PORT=5432
POSTGRES_DB=core_engine_stage
POSTGRES_USER=core_engine
POSTGRES_PASSWORD=<CAMBIAR secreto fuerte y único de stage>
POSTGRES_URL=postgres://core_engine:<CAMBIAR>@<CAMBIAR host>:5432/core_engine_stage

# Conexión de los microservicios (la que usan las apps)
DATABASE_URL=postgres://core_engine:<CAMBIAR>@<CAMBIAR host>:5432/core_engine_stage

# RabbitMQ: credencial DEDICADA y vhost de stage (distinta de producción)
RABBITMQ_USER=core-engine
RABBITMQ_PASSWORD=<CAMBIAR secreto fuerte y único de stage>
RABBITMQ_URL=amqp://core-engine:<CAMBIAR>@rabbitmq:5672

# MinIO: almacenamiento de objetos con UN BUCKET POR TENANT (ADR-24).
# Credencial unica de stage (no reutilizar la de produccion).
MINIO_ROOT_USER=core-engine-minio
MINIO_ROOT_PASSWORD=<CAMBIAR secreto fuerte y unico de stage>
MINIO_ENDPOINT=minio
MINIO_PORT=9000
MINIO_USE_SSL=false
# Endpoint PUBLICO firmado en las URLs prefirmadas: el dominio HTTPS con el que
# el cliente alcanza MinIO (MINIO_PUBLIC_PORT=443, MINIO_PUBLIC_USE_SSL=true).
# El 9000 interno no se expone: lo alcanza Traefik.
MINIO_PUBLIC_ENDPOINT=<CAMBIAR host publico de MinIO de stage>
MINIO_PUBLIC_PORT=9000
MINIO_PUBLIC_USE_SSL=false

# Limites del servicio de almacenamiento (bytes/segundos)
STORAGE_BUCKET_PREFIX=t-
STORAGE_MAX_OBJETO_BYTES=26214400
STORAGE_CUOTA_DEFAULT_BYTES=5368709120
STORAGE_URL_TTL_SEGUNDOS=900

# Outbox (R-AR-3): tabla outbox por servicio (incluir schema: ej. orders.outbox)
OUTBOX_TABLA=<CAMBIAR por schema y tabla correspondiente al servicio>

# JWT (en Supabase usar SUPABASE_JWT_SECRET)
JWT_SECRET=<CAMBIAR secreto fuerte y único de stage>
JWT_ACCESS_TTL=900s
JWT_REFRESH_TTL=7d

# Clave interna entre servicios
INTERNAL_API_KEY=<CAMBIAR clave interna fuerte de stage>

# Administrador inicial de stage: cambiar y rotar tras el primer arranque
ADMIN_EMAIL=<CAMBIAR>
ADMIN_PASSWORD=<CAMBIAR>

# Comisión de la plataforma (RN-04)
COMMISSION_RATE=0.12
PLATFORM_LOGISTICS_TENANT_ID=REEMPLAZAR_UUID_TENANT_FLOTA_GLOBAL_STAGE

# Logs / observabilidad
LOG_LEVEL=info
OTEL_EXPORTER_OTLP_ENDPOINT=

# CORS: dominio de staging del frontend, NUNCA `*`
CORS_ORIGINS=<CAMBIAR dominio de staging>

# Endurecimiento del borde (R-DS-3): staging NO debe ser publico. Con esta
# variable el gateway exige Basic Auth en todas las rutas salvo /health.
# Produccion NO la lleva: su frontend publico debe poder llamar.
EDGE_BASIC_AUTH=<CAMBIAR usuario:clave fuerte>
# Origen exento del Basic (staging/demo publico de Firebase). El navegador envia
# `Origin`; NO es autenticacion (un cliente no-navegador puede falsificarlo).
# Dejar vacio para exigir Basic a todos los origenes. Produccion no lo usa.
EDGE_BASIC_BYPASS_ORIGINS=https://kb-coleccion-internacional-ni.web.app
# Superficie de diagnostico (/docs, /docs-json, /metrics): privada (404 sin la
# clave interna). Dejar en false salvo que se quiera exponer a proposito.
DIAGNOSTICOS_PUBLICOS=false

# Readiness operativo: false exige `x-internal-key` (recomendado en stage);
# true lo deja publico (solo desarrollo local). El smoke debe enviar la clave.
READY_PUBLIC=false
# Cache del resultado de /ready en ms (0 desactiva). Evita que una rafaga
# amplifique a los 8 microservicios.
READY_CACHE_MS=5000
# Un unico proxy de borde (Traefik/Dockploy) delante del gateway: el rate limit
# usa la IP real de X-Forwarded-For. `false` solo si se accede directo.
TRUST_PROXY=1

# Observabilidad: solo se lee si se activa `docker-compose.observability.yml`
GRAFANA_ADMIN_PASSWORD=<CAMBIAR secreto fuerte de stage>
