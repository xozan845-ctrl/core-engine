# ── Core Engine · Variables de STAGE (plantilla) ──────────────────────────
# En local: copia este archivo a `.env.stage` (NO se versiona; ver .gitignore) y
# rellena cada valor. En Dockploy, pega estas variables en la pestaña
# *Environment* del environment `staging`: Dockploy las escribe a `.env`, el
# archivo que el compose consume por defecto (`ENV_FILE`, R-CD-7).
# Los secretos se inyectan en runtime, nunca en la imagen (R-CD-7).
#
# Mismos servicios que producción; valores ÚNICOS de stage (no reutilizar los de
# producción). La BD de stage es una base de datos aparte del mismo Postgres
# (aislamiento lógico, R-CD-9).

# Timezone fija de runtime (R-FL-3)
TZ=America/Managua

# Postgres de stage (base de datos dedicada, no compartir con producción)
POSTGRES_HOST=<CAMBIAR host de la BD de stage>
POSTGRES_PORT=5432
POSTGRES_DB=core_engine_stage
POSTGRES_USER=core_engine
POSTGRES_PASSWORD=<CAMBIAR secreto fuerte y único de stage>
CORE_ENGINE_APP_PASSWORD=<CAMBIAR contraseña del rol core_engine_app>
POSTGRES_URL=postgres://core_engine:<CAMBIAR>@<CAMBIAR host>:5432/core_engine_stage

# Conexión de los microservicios (la que usan las apps)
DATABASE_URL=postgres://core_engine_app:<CAMBIAR>@<CAMBIAR host>:5432/core_engine_stage
DATABASE_POOL_MAX=4

# RabbitMQ: credencial DEDICADA y vhost de stage (distinta de producción)
RABBITMQ_USER=core-engine
RABBITMQ_PASSWORD=<CAMBIAR secreto fuerte y único de stage>
RABBITMQ_URL=amqp://core-engine:<CAMBIAR>@rabbitmq:5672

# MinIO: almacenamiento de objetos con UN BUCKET POR TENANT (ADR-24).
# Credencial unica de stage (no reutilizar la de produccion).
MINIO_ROOT_USER=core-engine-minio
MINIO_ROOT_PASSWORD=<CAMBIAR secreto fuerte y unico de stage>
MINIO_ENDPOINT=minio
MINIO_PORT=9000
MINIO_USE_SSL=false
# Endpoint PUBLICO firmado en las URLs prefirmadas: el dominio HTTPS con el que
# el cliente alcanza MinIO (MINIO_PUBLIC_PORT=443, MINIO_PUBLIC_USE_SSL=true).
# El 9000 interno no se expone: lo alcanza Traefik.
MINIO_PUBLIC_ENDPOINT=<CAMBIAR host publico de MinIO de stage>
MINIO_PUBLIC_PORT=443
MINIO_PUBLIC_USE_SSL=true

# Limites del servicio de almacenamiento (bytes/segundos)
STORAGE_BUCKET_PREFIX=t-
STORAGE_MAX_OBJETO_BYTES=26214400
STORAGE_MAX_VIDEO_BYTES=104857600
STORAGE_CUOTA_DEFAULT_BYTES=5368709120
STORAGE_URL_TTL_SEGUNDOS=900

# Outbox (R-AR-3): tabla outbox por servicio (incluir schema: ej. orders.outbox)
OUTBOX_TABLA=<CAMBIAR por schema y tabla correspondiente al servicio>

# JWT (en Supabase usar SUPABASE_JWT_SECRET)
JWT_SECRET=<CAMBIAR secreto fuerte y único de stage>
JWT_ACCESS_TTL=900s
JWT_REFRESH_TTL=7d
AUTH_EXIGIR_CORREO_VERIFICADO=true
STORAGE_SERVICE_URL=http://storage-service:3010
PDF_ALMACENAMIENTO=storage
MFA_ENCRYPTION_KEY=<CAMBIAR base64 32 bytes>
AUDITORIA_RETENCION_DIAS=365
AUDITORIA_RETENCION_MODO=anonimizar
EXPORT_SIGNING_KEY=<CAMBIAR clave HMAC fuerte>
TENANT_PURGE_SERVICES=commissions=http://commissions-service:3006,logistics=http://logistics-service:3005,analytics=http://analytics-service:3016,inventory=http://inventory-service:3013,pricing=http://pricing-service:3014,stores=http://stores-service:3003,item=http://item-service:3015,finance=http://finance-service:3007,storage=http://storage-service:3010,field=http://field-service:3008,intelligence=http://market-intelligence-service:3009,scheduling=http://scheduling-service:3011,notifications=http://notifications-service:3012,orders=http://orders-service:3004


# Clave interna entre servicios
PAGO_WEBHOOK_SECRET=<CAMBIAR secreto de webhook de pagos>
PAGO_PROVEEDOR=simulado
# PAGO_PROVEEDOR_URL=https://pasarela.ejemplo
# PAGO_PROVEEDOR_KEY=<CAMBIAR clave de la pasarela>
# El gateway está detrás del proxy/load balancer de la plataforma.
TRUST_FORWARDED_FOR=true
INTERNAL_API_KEY=<CAMBIAR clave interna fuerte de stage>

# Administrador inicial de stage: cambiar y rotar tras el primer arranque
ADMIN_EMAIL=<CAMBIAR>
ADMIN_PASSWORD=<CAMBIAR>

# Comisión de la plataforma (RN-04)
COMMISSION_RATE=0.12
# Expiración de órdenes impagas: TTL en minutos (0 desactiva) y frecuencia del barrido
ORDEN_PAGO_TTL_MINUTOS=30
ORDEN_EXPIRACION_INTERVALO_SEGUNDOS=60
PAGOS_CONCILIACION_INTERVALO_SEGUNDOS=900
PAGOS_CONCILIACION_MINUTOS=10
PLATFORM_LOGISTICS_TENANT_ID=REEMPLAZAR_UUID_TENANT_FLOTA_GLOBAL_STAGE
PLATFORM_TENANT_ID=REEMPLAZAR_UUID_TENANT_ASSETS_PLATAFORMA_STAGE

# Logs / observabilidad
LOG_LEVEL=info
OTEL_EXPORTER_OTLP_ENDPOINT=

# CORS: dominio de staging del frontend, NUNCA `*`
CORS_ORIGINS=<CAMBIAR dominio de staging>

# Staging NO debe ser publico: el acceso se cierra en el borde externo
# (Cloudflare Access, VPN o allowlist de IP) segun ADR-0005. El gateway no
# implementa Basic Auth; no hay EDGE_BASIC_AUTH.
# Superficie de diagnostico (/docs, /docs-json, /metrics): privada (404 sin la
# clave interna). Dejar en false salvo que se quiera exponer a proposito.
DIAGNOSTICOS_PUBLICOS=false

# Readiness operativo: false exige `x-internal-key` (recomendado en stage);
# true lo deja publico (solo desarrollo local). El smoke debe enviar la clave.
READY_PUBLIC=false
# Cache del resultado de /ready en ms (0 desactiva). Evita que una rafaga
# amplifique a los 8 microservicios.
READY_CACHE_MS=5000
# Un unico proxy de borde (Traefik/Dockploy) delante del gateway: el rate limit
# usa la IP real de X-Forwarded-For. `false` solo si se accede directo.
TRUST_PROXY=1

# Observabilidad: solo se lee si se activa `docker-compose.observability.yml`
GRAFANA_ADMIN_PASSWORD=<CAMBIAR secreto fuerte de stage>

# Correo transaccional (ADR-0003). En stage se usa SMTP real.
EMAIL_MODE=smtp
EMAIL_FROM=<CAMBIAR correo remitente>
SMTP_HOST=<CAMBIAR host SMTP>
SMTP_PORT=587
SMTP_USER=<CAMBIAR usuario>
SMTP_PASSWORD=<CAMBIAR secreto>
# URL pública del frontend (enlaces de incorporación y reset de contraseña).
FRONTEND_URL=<CAMBIAR URL pública del frontend>

# Facturación electrónica (opt-in por negocio; sin URL usa el simulado)
# FACTURACION_PROVEEDOR_URL=https://proveedor-fiscal.ejemplo
# FACTURACION_PROVEEDOR_KEY=<CAMBIAR clave del proveedor fiscal>

NOTIFICATIONS_SERVICE_URL=http://notifications-service:3012
NOTIFICACIONES_CANALES=email
# WHATSAPP_TOKEN=<CAMBIAR token de Meta Cloud API>
# WHATSAPP_PHONE_ID=<CAMBIAR phone id>
# SMS_URL=<CAMBIAR endpoint del proveedor SMS>
# SMS_KEY=<CAMBIAR clave del proveedor SMS>

# Plan de plataforma (ADR-0046).
PLATAFORMA_PLAN_EMPRESARIO=empresario_plus
PLATAFORMA_EMPRESAS_GRATIS=1
PLATAFORMA_NEGOCIOS_GRATIS=1
# Webhooks salientes (ADR-0045).
WEBHOOK_TIMEOUT_MS=5000
WEBHOOK_REINTENTO_SEGUNDOS=60
WEBHOOK_HTTPS_OBLIGATORIO=true
# Backup lógico del sidecar (ADR-0044).
BACKUP_RETENCION_DIAS=14
BACKUP_INTERVALO_SEGUNDOS=86400

# Alertmanager: webhook que recibe las alertas (Slack/PagerDuty/email bridge).
ALERTMANAGER_WEBHOOK_URL=

# Pasarelas (los valores se configuran en el entorno, nunca en el repo).
# Tilopay: credenciales del panel · Platform integrations.
TILOPAY_APIUSER=
TILOPAY_PASSWORD=
TILOPAY_KEY=
# Pagadito: UID y WSK del panel · Integration Parameters.
PAGADITO_UID=
PAGADITO_WSK=
