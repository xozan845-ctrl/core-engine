# ── Core Engine · Variables de PRODUCCIÓN (plantilla) ─────────────────────
# Esta es una PLANTILLA: no commitear secretos reales. En Dockploy, pega estas
# variables en la pestaña **Environment** del proyecto/entorno (dev/stage/prod)
# y el valor de cada `<CAMBIAR>` debe ser un secreto fuerte y ÚNICO por entorno.
# Dockploy las escribe a `.env`, el archivo que el compose consume por defecto.
# Dev usa `.env.example`; producción usa este (en local: `.env.production` con
# `ENV_FILE=.env.production`).
#
# Regla (R-CD-7): los secretos se inyectan en runtime, nunca en la imagen.

# Postgres de producción (Postgres del VPS o Supabase, según infra/db)
POSTGRES_HOST=<CAMBIAR host de la BD>
POSTGRES_PORT=5432
POSTGRES_DB=core_engine
POSTGRES_USER=core_engine
POSTGRES_PASSWORD=<CAMBIAR secreto fuerte>
POSTGRES_URL=postgres://core_engine:<CAMBIAR>@<CAMBIAR host>:5432/core_engine

# Conexion de los microservicios (la que usan las apps)
DATABASE_URL=postgres://core_engine:<CAMBIAR>@<CAMBIAR host>:5432/core_engine

# RabbitMQ: credencial DEDICADA y distinta de la de desarrollo
RABBITMQ_USER=core-engine
RABBITMQ_PASSWORD=<CAMBIAR secreto fuerte>
RABBITMQ_URL=amqp://core-engine:<CAMBIAR>@rabbitmq:5672

# MinIO: almacenamiento de objetos con UN BUCKET POR TENANT (ADR-24).
# Credencial dedicada de produccion (distinta de stage/desarrollo).
MINIO_ROOT_USER=core-engine-minio
MINIO_ROOT_PASSWORD=<CAMBIAR secreto fuerte>
MINIO_ENDPOINT=minio
MINIO_PORT=9000
MINIO_USE_SSL=false
# Endpoint PUBLICO firmado en las URLs prefirmadas (dominio HTTPS que resuelve
# el cliente final; MINIO_PUBLIC_PORT=443, MINIO_PUBLIC_USE_SSL=true). El 9000
# interno no se expone: lo alcanza Traefik.
MINIO_PUBLIC_ENDPOINT=<CAMBIAR host publico de MinIO>
MINIO_PUBLIC_PORT=9000
MINIO_PUBLIC_USE_SSL=false

# Limites del servicio de almacenamiento (bytes/segundos)
STORAGE_BUCKET_PREFIX=t-
STORAGE_MAX_OBJETO_BYTES=26214400
STORAGE_CUOTA_DEFAULT_BYTES=5368709120
STORAGE_URL_TTL_SEGUNDOS=900

# Outbox (R-AR-3): tabla outbox por servicio (incluir schema: ej. orders.outbox)
OUTBOX_TABLA=<CAMBIAR por schema y tabla correspondiente al servicio>

# JWT (en Supabase usar SUPABASE_JWT_SECRET)
JWT_SECRET=<CAMBIAR secreto fuerte>
JWT_ACCESS_TTL=900s
JWT_REFRESH_TTL=7d

# Clave interna entre servicios
INTERNAL_API_KEY=<CAMBIAR clave interna fuerte>

# Administrador inicial: cambiar y rotar tras el primer arranque
ADMIN_EMAIL=<CAMBIAR>
ADMIN_PASSWORD=<CAMBIAR>

# Comisión de la plataforma (RN-04)
COMMISSION_RATE=0.12
PLATFORM_LOGISTICS_TENANT_ID=REEMPLAZAR_UUID_TENANT_FLOTA_GLOBAL

# Logs / observabilidad
LOG_LEVEL=info
OTEL_EXPORTER_OTLP_ENDPOINT=

# CORS: dominios reales del frontend, NUNCA `*` en producción
CORS_ORIGINS=<CAMBIAR dominios reales separados por coma>

# Superficie de diagnostico (/docs, /docs-json, /metrics): privada en produccion.
# (Sin EDGE_BASIC_AUTH: el frontend publico llama a la API sin credencial de borde.)
DIAGNOSTICOS_PUBLICOS=false

# Observabilidad: solo se lee si se activa `docker-compose.observability.yml`
GRAFANA_ADMIN_PASSWORD=<CAMBIAR secreto fuerte>
