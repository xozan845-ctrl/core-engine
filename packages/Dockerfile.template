# Core Engine · plantilla de Dockerfile por servicio (Rust)
# Copia este archivo a `packages/<servicio>/Dockerfile` al crear un servicio
# nuevo (R-CD-14 aplica al Dockerfile raiz, a esta plantilla y a cada servicio).
# Contexto de build: la RAÍZ del repositorio.
#   docker build -f packages/<servicio>/Dockerfile -t core-engine-<servicio> .
FROM rust:1.94.1-bookworm AS build
WORKDIR /repo

# Cargo.lock se copia para que `--locked` sea reproducible; la toolchain de la
# imagen debe soportar el `rust-version` de todas las dependencias.
COPY packages/<servicio>/Cargo.toml packages/<servicio>/Cargo.lock ./packages/<servicio>/
COPY docs/openapi/<servicio> ./docs/openapi/<servicio>

# Cachea las dependencias con un binario vacío antes de copiar el código real.
RUN cd packages/<servicio> \
    && mkdir -p src \
    && echo "fn main() {}" > src/main.rs \
    && cargo build --release --locked

COPY packages/<servicio>/src ./packages/<servicio>/src
COPY packages/<servicio>/tests ./packages/<servicio>/tests
RUN touch packages/<servicio>/src/main.rs \
    && cd packages/<servicio> \
    && cargo build --release --locked

FROM debian:bookworm-slim AS runtime
# El runtime NO lleva toolchain de compilación (R-CD-14): solo CA certs.
RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates curl \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY --from=build /repo/packages/<servicio>/target/release/<servicio> /usr/local/bin/<servicio>
ENV NODE_ENV=production
EXPOSE <puerto>
USER 10001:10001
ENTRYPOINT ["/usr/local/bin/<servicio>"]
