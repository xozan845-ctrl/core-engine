{
  "name": "@core-engine/qa-harness",
  "version": "1.0.0",
  "description": "QA Harness agresivo para Core Engine Core Engine - Testing automatizado con reporte ultra detallado",
  "type": "module",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "test": "node src/index.js --suites 01-auth,02-role-access --format html",
    "test:full": "node src/index.js --format all",
    "test:security": "node src/index.js --suites 01-auth,02-role-access,11-fuzzing",
    "test:business": "node src/index.js --suites 03-catalog,04-stores,05-orders,06-cart,07-logistics,08-commissions,09-finanzas,21-market-intelligence",
    "test:load": "node src/index.js --suites 13-load --load agresivo --concurrency 100",
    "test:concurrency": "node src/index.js --suites 12-concurrency",
    "test:static": "node src/index.js --suites 15-static",
    "test:queue": "node src/index.js --suites 14-queue",
    "report:html": "node src/index.js --format html --output ./reports",
    "report:md": "node src/index.js --format md --output ./reports",
    "report:json": "node src/index.js --format json --output ./reports",
    "clean": "rm -rf reports"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "qa",
    "testing",
    "core-engine",
    "core-engine",
    "aggressive-testing",
    "roost",
    "automated-testing"
  ],
  "author": "Core Engine Team",
  "license": "MIT",
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "pg": "^8.11.0",
    "jsonwebtoken": "^9.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/pg": "^8.10.0",
    "@types/jsonwebtoken": "^9.0.0"
  }
}