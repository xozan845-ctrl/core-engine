{
    "title":  "Core Engine - Alerts \u0026 Health Summary",
    "uid":  "core-engine-alerts",
    "description":  "Single-pane-of-glass: estado de salud y alertas activas de toda la plataforma Core Engine. NOTA: heap usage alto (\u003e85%) es COMPORTAMIENTO NORMAL de V8 (GC eficiente); el dashboard de Node.js muestra el contexto completo.",
    "timezone":  "browser",
    "refresh":  "10s",
    "time":  {
                 "from":  "now-15m",
                 "to":  "now"
             },
    "templating":  {
                       "list":  [
                                    {
                                        "name":  "servicio",
                                        "type":  "query",
                                        "datasource":  {
                                                           "type":  "prometheus",
                                                           "uid":  "prometheus"
                                                       },
                                        "refresh":  1,
                                        "query":  "label_values(nodejs_heap_size_used_bytes{job=~\"core-engine-servicios\"}, instance)",
                                        "includeAll":  true,
                                        "multi":  true,
                                        "allValue":  ".*",
                                        "current":  {
                                                        "text":  "All",
                                                        "value":  ".*"
                                                    }
                                    }
                                ]
                   },
    "panels":  [
                   {
                       "type":  "stat",
                       "title":  " Estado General",
                       "gridPos":  {
                                       "x":  0,
                                       "y":  0,
                                       "w":  24,
                                       "h":  5
                                   },
                       "datasource":  "Prometheus",
                       "targets":  [
                                       {
                                           "expr":  "count(up{job=\"core-engine-servicios\"} == 1)",
                                           "legendFormat":  "servicios_up",
                                           "refId":  "A"
                                       }
                                   ],
                       "fieldConfig":  {
                                           "defaults":  {
                                                            "unit":  "short",
                                                            "mappings":  [
                                                                             {
                                                                                 "type":  "value",
                                                                                 "options":  {
                                                                                                 "8":  {
                                                                                                           "text":  "8/8 ✓ Saludable",
                                                                                                           "color":  "green"
                                                                                                       },
                                                                                                 "7":  {
                                                                                                           "text":  "7/8 ⚠ Servicio caído",
                                                                                                           "color":  "orange"
                                                                                                       }
                                                                                             }
                                                                             }
                                                                         ]
                                                        }
                                       }
                   },
                   {
                       "type":  "stat",
                       "title":  " Servicios Caídos (últimos 5 min)",
                       "gridPos":  {
                                       "x":  0,
                                       "y":  5,
                                       "w":  4,
                                       "h":  4
                                   },
                       "datasource":  "Prometheus",
                       "targets":  [
                                       {
                                           "expr":  "count(up{job=\"core-engine-servicios\"} == 0)",
                                           "refId":  "A"
                                       }
                                   ],
                       "fieldConfig":  {
                                           "defaults":  {
                                                            "unit":  "short",
                                                            "thresholds":  {
                                                                               "mode":  "absolute",
                                                                               "steps":  [
                                                                                             {
                                                                                                 "value":  null,
                                                                                                 "color":  "green"
                                                                                             },
                                                                                             {
                                                                                                 "value":  1,
                                                                                                 "color":  "red"
                                                                                             }
                                                                                         ]
                                                                           }
                                                        }
                                       }
                   },
                   {
                       "type":  "stat",
                       "title":  " Latencia p99 (ms)",
                       "gridPos":  {
                                       "x":  4,
                                       "y":  5,
                                       "w":  4,
                                       "h":  4
                                   },
                       "datasource":  "Prometheus",
                       "targets":  [
                                       {
                                           "expr":  "histogram_quantile(0.99, sum by (servicio, le) (rate(http_peticion_latencia_ms_bucket[5m])))",
                                           "legendFormat":  "{{servicio}}",
                                           "refId":  "A"
                                       }
                                   ],
                       "fieldConfig":  {
                                           "defaults":  {
                                                            "unit":  "ms",
                                                            "thresholds":  {
                                                                               "mode":  "absolute",
                                                                               "steps":  [
                                                                                             {
                                                                                                 "value":  null,
                                                                                                 "color":  "green"
                                                                                             },
                                                                                             {
                                                                                                 "value":  400,
                                                                                                 "color":  "orange"
                                                                                             },
                                                                                             {
                                                                                                 "value":  800,
                                                                                                 "color":  "red"
                                                                                             }
                                                                                         ]
                                                                           }
                                                        }
                                       }
                   },
                   {
                       "type":  "stat",
                       "title":  " Error Rate 5xx (%)",
                       "gridPos":  {
                                       "x":  8,
                                       "y":  5,
                                       "w":  4,
                                       "h":  4
                                   },
                       "datasource":  "Prometheus",
                       "targets":  [
                                       {
                                           "expr":  "sum(rate(http_peticiones_total{status=~\"5..\"}[5m])) / sum(rate(http_peticiones_total[5m])) * 100",
                                           "refId":  "A"
                                       }
                                   ],
                       "fieldConfig":  {
                                           "defaults":  {
                                                            "unit":  "percent",
                                                            "thresholds":  {
                                                                               "mode":  "absolute",
                                                                               "steps":  [
                                                                                             {
                                                                                                 "value":  null,
                                                                                                 "color":  "green"
                                                                                             },
                                                                                             {
                                                                                                 "value":  1,
                                                                                                 "color":  "orange"
                                                                                             },
                                                                                             {
                                                                                                 "value":  5,
                                                                                                 "color":  "red"
                                                                                             }
                                                                                         ]
                                                                           }
                                                        }
                                       }
                   },
                   {
                       "type":  "stat",
                       "title":  " Event Loop Lag p99 (ms)",
                       "gridPos":  {
                                       "x":  12,
                                       "y":  5,
                                       "w":  4,
                                       "h":  4
                                   },
                       "datasource":  "Prometheus",
                       "targets":  [
                                       {
                                           "expr":  "nodejs_eventloop_lag_p99_seconds{job=~\"core-engine-servicios\"} * 1000",
                                           "legendFormat":  "{{instance}}",
                                           "refId":  "A"
                                       }
                                   ],
                       "fieldConfig":  {
                                           "defaults":  {
                                                            "unit":  "ms",
                                                            "thresholds":  {
                                                                               "mode":  "absolute",
                                                                               "steps":  [
                                                                                             {
                                                                                                 "value":  null,
                                                                                                 "color":  "green"
                                                                                             },
                                                                                             {
                                                                                                 "value":  50,
                                                                                                 "color":  "orange"
                                                                                             },
                                                                                             {
                                                                                                 "value":  100,
                                                                                                 "color":  "red"
                                                                                             }
                                                                                         ]
                                                                           }
                                                        }
                                       }
                   },
                   {
                       "type":  "stat",
                       "title":  " GC Major Avg (ms)",
                       "gridPos":  {
                                       "x":  16,
                                       "y":  5,
                                       "w":  4,
                                       "h":  4
                                   },
                       "datasource":  "Prometheus",
                       "targets":  [
                                       {
                                           "expr":  "rate(nodejs_gc_duration_seconds_sum{kind=\"major\"}[5m]) / rate(nodejs_gc_duration_seconds_count{kind=\"major\"}[5m]) * 1000",
                                           "legendFormat":  "{{instance}}",
                                           "refId":  "A"
                                       }
                                   ],
                       "fieldConfig":  {
                                           "defaults":  {
                                                            "unit":  "ms",
                                                            "thresholds":  {
                                                                               "mode":  "absolute",
                                                                               "steps":  [
                                                                                             {
                                                                                                 "value":  null,
                                                                                                 "color":  "green"
                                                                                             },
                                                                                             {
                                                                                                 "value":  500,
                                                                                                 "color":  "orange"
                                                                                             },
                                                                                             {
                                                                                                 "value":  1000,
                                                                                                 "color":  "red"
                                                                                             }
                                                                                         ]
                                                                           }
                                                        }
                                       }
                   },
                   {
                       "type":  "stat",
                       "title":  " Heap Used (MB) — NOTA: alto % es normal",
                       "gridPos":  {
                                       "x":  20,
                                       "y":  5,
                                       "w":  4,
                                       "h":  4
                                   },
                       "datasource":  "Prometheus",
                       "targets":  [
                                       {
                                           "expr":  "nodejs_heap_size_used_bytes{job=~\"core-engine-servicios\"} / 1024 / 1024",
                                           "legendFormat":  "{{instance}}",
                                           "refId":  "A"
                                       }
                                   ],
                       "fieldConfig":  {
                                           "defaults":  {
                                                            "unit":  "decmegabytes",
                                                            "thresholds":  {
                                                                               "mode":  "absolute",
                                                                               "steps":  [
                                                                                             {
                                                                                                 "value":  null,
                                                                                                 "color":  "green"
                                                                                             },
                                                                                             {
                                                                                                 "value":  300,
                                                                                                 "color":  "orange"
                                                                                             },
                                                                                             {
                                                                                                 "value":  500,
                                                                                                 "color":  "red"
                                                                                             }
                                                                                         ]
                                                                           }
                                                        }
                                       }
                   },
                   {
                       "type":  "stat",
                       "title":  " Conexiones PG",
                       "gridPos":  {
                                       "x":  0,
                                       "y":  9,
                                       "w":  4,
                                       "h":  4
                                   },
                       "datasource":  "Prometheus",
                       "targets":  [
                                       {
                                           "expr":  "pg_stat_database_numbackends{datname=\"core-engine\"}",
                                           "refId":  "A"
                                       }
                                   ],
                       "fieldConfig":  {
                                           "defaults":  {
                                                            "unit":  "short",
                                                            "thresholds":  {
                                                                               "mode":  "absolute",
                                                                               "steps":  [
                                                                                             {
                                                                                                 "value":  null,
                                                                                                 "color":  "green"
                                                                                             },
                                                                                             {
                                                                                                 "value":  80,
                                                                                                 "color":  "orange"
                                                                                             },
                                                                                             {
                                                                                                 "value":  95,
                                                                                                 "color":  "red"
                                                                                             }
                                                                                         ]
                                                                           }
                                                        }
                                       }
                   },
                   {
                       "type":  "stat",
                       "title":  " Cache Hit Ratio PG (%)",
                       "gridPos":  {
                                       "x":  4,
                                       "y":  9,
                                       "w":  4,
                                       "h":  4
                                   },
                       "datasource":  "Prometheus",
                       "targets":  [
                                       {
                                           "expr":  "pg_stat_database_blks_hit / (pg_stat_database_blks_hit + pg_stat_database_blks_read) * 100",
                                           "refId":  "A"
                                       }
                                   ],
                       "fieldConfig":  {
                                           "defaults":  {
                                                            "unit":  "percent",
                                                            "thresholds":  {
                                                                               "mode":  "absolute",
                                                                               "steps":  [
                                                                                             {
                                                                                                 "value":  null,
                                                                                                 "color":  "green"
                                                                                             },
                                                                                             {
                                                                                                 "value":  95,
                                                                                                 "color":  "orange"
                                                                                             },
                                                                                             {
                                                                                                 "value":  90,
                                                                                                 "color":  "red"
                                                                                             }
                                                                                         ]
                                                                           }
                                                        }
                                       }
                   },
                   {
                       "type":  "stat",
                       "title":  " Dead Tuples PG",
                       "gridPos":  {
                                       "x":  8,
                                       "y":  9,
                                       "w":  4,
                                       "h":  4
                                   },
                       "datasource":  "Prometheus",
                       "targets":  [
                                       {
                                           "expr":  "sum(pg_stat_user_tables_n_dead_tup)",
                                           "refId":  "A"
                                       }
                                   ],
                       "fieldConfig":  {
                                           "defaults":  {
                                                            "unit":  "short",
                                                            "thresholds":  {
                                                                               "mode":  "absolute",
                                                                               "steps":  [
                                                                                             {
                                                                                                 "value":  null,
                                                                                                 "color":  "green"
                                                                                             },
                                                                                             {
                                                                                                 "value":  50,
                                                                                                 "color":  "orange"
                                                                                             },
                                                                                             {
                                                                                                 "value":  100,
                                                                                                 "color":  "red"
                                                                                             }
                                                                                         ]
                                                                           }
                                                        }
                                       }
                   },
                   {
                       "type":  "stat",
                       "title":  " RabbitMQ Queue Backlog",
                       "gridPos":  {
                                       "x":  12,
                                       "y":  9,
                                       "w":  4,
                                       "h":  4
                                   },
                       "datasource":  "Prometheus",
                       "targets":  [
                                       {
                                           "expr":  "max(rabbitmq_queue_messages)",
                                           "refId":  "A"
                                       }
                                   ],
                       "fieldConfig":  {
                                           "defaults":  {
                                                            "unit":  "short",
                                                            "thresholds":  {
                                                                               "mode":  "absolute",
                                                                               "steps":  [
                                                                                             {
                                                                                                 "value":  null,
                                                                                                 "color":  "green"
                                                                                             },
                                                                                             {
                                                                                                 "value":  50,
                                                                                                 "color":  "orange"
                                                                                             },
                                                                                             {
                                                                                                 "value":  1000,
                                                                                                 "color":  "red"
                                                                                             }
                                                                                         ]
                                                                           }
                                                        }
                                       }
                   },
                   {
                       "type":  "stat",
                       "title":  " RabbitMQ Consumers",
                       "gridPos":  {
                                       "x":  16,
                                       "y":  9,
                                       "w":  4,
                                       "h":  4
                                   },
                       "datasource":  "Prometheus",
                       "targets":  [
                                       {
                                           "expr":  "sum(rabbitmq_queue_consumers)",
                                           "refId":  "A"
                                       }
                                   ],
                       "fieldConfig":  {
                                           "defaults":  {
                                                            "unit":  "short",
                                                            "thresholds":  {
                                                                               "mode":  "absolute",
                                                                               "steps":  [
                                                                                             {
                                                                                                 "value":  null,
                                                                                                 "color":  "red"
                                                                                             },
                                                                                             {
                                                                                                 "value":  1,
                                                                                                 "color":  "orange"
                                                                                             },
                                                                                             {
                                                                                                 "value":  3,
                                                                                                 "color":  "green"
                                                                                             }
                                                                                         ]
                                                                           }
                                                        }
                                       }
                   },
                   {
                       "type":  "stat",
                       "title":  " Disk Usage (%)",
                       "gridPos":  {
                                       "x":  20,
                                       "y":  9,
                                       "w":  4,
                                       "h":  4
                                   },
                       "datasource":  "Prometheus",
                       "targets":  [
                                       {
                                           "expr":  "max by (instance) ((node_filesystem_size_bytes - node_filesystem_avail_bytes) / node_filesystem_size_bytes) * 100",
                                           "refId":  "A"
                                       }
                                   ],
                       "fieldConfig":  {
                                           "defaults":  {
                                                            "unit":  "percent",
                                                            "thresholds":  {
                                                                               "mode":  "absolute",
                                                                               "steps":  [
                                                                                             {
                                                                                                 "value":  null,
                                                                                                 "color":  "green"
                                                                                             },
                                                                                             {
                                                                                                 "value":  80,
                                                                                                 "color":  "orange"
                                                                                             },
                                                                                             {
                                                                                                 "value":  90,
                                                                                                 "color":  "red"
                                                                                             }
                                                                                         ]
                                                                           }
                                                        }
                                       }
                   },
                   {
                       "type":  "table",
                       "title":  " Alertas Activas",
                       "gridPos":  {
                                       "x":  0,
                                       "y":  13,
                                       "w":  24,
                                       "h":  20
                                   },
                       "datasource":  "Prometheus",
                       "targets":  [
                                       {
                                           "expr":  "ALERTS{alertstate=\"firing\"}",
                                           "refId":  "A",
                                           "format":  "table"
                                       }
                                   ],
                       "fieldConfig":  {
                                           "defaults":  {
                                                            "custom":  {
                                                                           "align":  "auto"
                                                                       }
                                                        }
                                       }
                   }
               ]
}
