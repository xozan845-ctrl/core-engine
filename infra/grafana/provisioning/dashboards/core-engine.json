{
  "annotations": { "list": [] },
  "editable": true,
  "graphTooltip": 1,
  "title": "Core Engine · Core Engine",
  "uid": "core-engine-core",
  "panels": [
    {
      "id": 1,
      "title": "Latencia p99 por servicio (s)",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 0.3 },
              { "color": "red", "value": 0.4 }
            ]
          }
        }
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "targets": [
        {
          "expr": "histogram_quantile(0.99, sum by (le, servicio) (rate(core_engine_http_request_duration_seconds_bucket[5m])))",
          "legendFormat": "{{servicio}}"
        }
      ]
    },
    {
      "id": 2,
      "title": "Peticiones por segundo (por servicio)",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "targets": [
        {
          "expr": "sum by (servicio) (rate(core_engine_http_requests_total[5m]))",
          "legendFormat": "{{servicio}}"
        }
      ]
    },
    {
      "id": 3,
      "title": "Errores 5xx (%)",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 0.005 },
              { "color": "red", "value": 0.01 }
            ]
          }
        }
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "targets": [
        {
          "expr": "sum by (servicio) (rate(core_engine_http_server_errors_total[5m])) / clamp_min(sum by (servicio) (rate(core_engine_http_requests_total[5m])), 1e-9)",
          "legendFormat": "{{servicio}}"
        }
      ]
    },
    {
      "id": 4,
      "title": "Mensajes pendientes (backlog de colas)",
      "type": "stat",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 1000 }
            ]
          }
        }
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "targets": [
        {
          "expr": "rabbitmq_global_messages_unacknowledged",
          "legendFormat": "unacknowledged"
        }
      ]
    }
  ],
  "schemaVersion": 39,
  "tags": ["core-engine", "microservicios"],
  "time": { "from": "now-6h", "to": "now" }
}
