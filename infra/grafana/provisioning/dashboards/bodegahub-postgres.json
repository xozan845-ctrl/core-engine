{
  "title": "BodegaHub - PostgreSQL",
  "uid": "bodegahub-postgres",
  "timezone": "browser",
  "refresh": "10s",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "panels": [
    {
      "type": "timeseries",
      "title": "Conexiones activas / maximas",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "pg_stat_database_numbackends{datname=\"bodegahub\"}",
          "legendFormat": "activas",
          "refId": "A"
        },
        {
          "expr": "pg_settings_max_connections",
          "legendFormat": "max_connections",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "value": null,
                "color": "green"
              },
              {
                "value": 80,
                "color": "orange"
              },
              {
                "value": 95,
                "color": "red"
              }
            ]
          }
        }
      }
    },
    {
      "type": "timeseries",
      "title": "Cache Hit Ratio (%)",
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "pg_stat_database_blks_hit / (pg_stat_database_blks_hit + pg_stat_database_blks_read) * 100",
          "legendFormat": "hit_ratio_%",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "value": null,
                "color": "green"
              },
              {
                "value": 95,
                "color": "orange"
              },
              {
                "value": 90,
                "color": "red"
              }
            ]
          }
        }
      }
    },
    {
      "type": "timeseries",
      "title": "Tuples: inserts/updates/deletes/s (por tabla schema)",
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "sum by (schemaname, relname) (rate(pg_stat_user_tables_n_tup_ins[5m]))",
          "legendFormat": "ins {{schemaname}}.{{relname}}",
          "refId": "A"
        },
        {
          "expr": "sum by (schemaname, relname) (rate(pg_stat_user_tables_n_tup_upd[5m]))",
          "legendFormat": "upd {{schemaname}}.{{relname}}",
          "refId": "B"
        },
        {
          "expr": "sum by (schemaname, relname) (rate(pg_stat_user_tables_n_tup_del[5m]))",
          "legendFormat": "del {{schemaname}}.{{relname}}",
          "refId": "C"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        }
      }
    },
    {
      "type": "timeseries",
      "title": "Indices: scans/s y tuples read/s",
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "sum by (schemaname, relname) (rate(pg_stat_user_tables_idx_scan[5m]))",
          "legendFormat": "idx_scan {{schemaname}}.{{relname}}",
          "refId": "A"
        },
        {
          "expr": "sum by (schemaname, relname) (rate(pg_stat_user_tables_idx_tup_fetch[5m]))",
          "legendFormat": "idx_read {{schemaname}}.{{relname}}",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        }
      }
    },
    {
      "type": "timeseries",
      "title": "Tamano de BD y tablas mayores (MB)",
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "pg_database_size_bytes{datname=\"bodegahub\"} / 1024 / 1024",
          "legendFormat": "bodegahub total MB",
          "refId": "A"
        },
        {
          "expr": "pg_stat_user_tables_table_size_bytes / 1024 / 1024",
          "legendFormat": "{{schemaname}}.{{relname}} MB",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "decmegabytes"
        }
      }
    },
    {
      "type": "timeseries",
      "title": "Tuplas vivas/muertas por tabla",
      "gridPos": {
        "x": 12,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "pg_stat_user_tables_n_live_tup",
          "legendFormat": "live {{schemaname}}.{{relname}}",
          "refId": "A"
        },
        {
          "expr": "pg_stat_user_tables_n_dead_tup",
          "legendFormat": "dead {{schemaname}}.{{relname}}",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        }
      }
    },
    {
      "type": "stat",
      "title": "Bloqueos activos",
      "gridPos": {
        "x": 0,
        "y": 24,
        "w": 6,
        "h": 4
      },
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "sum(pg_locks_count{datname=\"bodegahub\"})",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        }
      }
    },
    {
      "type": "stat",
      "title": "Transacciones commit/rollback/s",
      "gridPos": {
        "x": 6,
        "y": 24,
        "w": 6,
        "h": 4
      },
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "rate(pg_stat_database_xact_commit[5m])",
          "legendFormat": "commit/s",
          "refId": "A"
        },
        {
          "expr": "rate(pg_stat_database_xact_rollback[5m])",
          "legendFormat": "rollback/s",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        }
      }
    },
    {
      "type": "row",
      "title": "Performance de Queries (pg_stat_statements)",
      "gridPos": {
        "x": 0,
        "y": 28,
        "w": 24,
        "h": 1
      },
      "collapsed": false,
      "panels": []
    },
    {
      "id": 101,
      "type": "timeseries",
      "title": "Top queries por latencia media (ms)",
      "gridPos": {
        "x": 0,
        "y": 29,
        "w": 12,
        "h": 8
      },
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "topk(10, pg_query_latency_mean_time_ms)",
          "legendFormat": "{{query_preview}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "custom": {
            "lineWidth": 1
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "value": null,
                "color": "green"
              },
              {
                "value": 100,
                "color": "orange"
              },
              {
                "value": 1000,
                "color": "red"
              }
            ]
          }
        }
      }
    },
    {
      "id": 102,
      "type": "timeseries",
      "title": "Ejecuciones/s por query (calls)",
      "gridPos": {
        "x": 12,
        "y": 29,
        "w": 12,
        "h": 8
      },
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "topk(10, rate(pg_query_latency_calls[5m]))",
          "legendFormat": "{{query_preview}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "custom": {
            "lineWidth": 1
          }
        }
      }
    },
    {
