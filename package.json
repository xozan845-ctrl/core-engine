{
  "name": "core-engine",
  "version": "1.9.0",
  "private": true,
  "description": "Core Engine - plataforma multi-vertical por capacidades sobre microservicios Rust + PostgreSQL/Supabase + Docker",
  "scripts": {
    "demo": "node scripts/cli.mjs smoke",
    "smoke:remote": "node scripts/tools/smoke-remote.mjs",
    "lint": "eslint .",
    "rules:check": "node scripts/cli.mjs rules",
    "release:check": "node scripts/tools/release-check.mjs",
    "version:bump": "node scripts/tools/version-bump.mjs",
    "test:engine": "node --test scripts/engine/lib/*.test.mjs scripts/engine/*.test.mjs",
    "test:smoke": "node --test scripts/tools/*.test.mjs",
    "test:integration": "node scripts/tools/integration-runner.mjs",
    "db:migrations": "node scripts/tools/db-migrations.mjs",
    "db:rls": "node scripts/tools/db-rls.mjs",
    "env:check": "node scripts/tools/env-check.mjs",
    "promotion:check": "node scripts/tools/promotion-check.mjs",
    "security:secrets": "node scripts/tools/secrets-check.mjs",
    "multi-vertical:check": "node scripts/tools/multi-vertical-check.mjs",
    "baseline:guard": "node scripts/tools/baseline-guard.mjs",
    "swagger:export": "node scripts/cli.mjs swagger",
    "deploy:digest": "node scripts/tools/render-compose-digest.mjs",
    "demo:verticals": "node scripts/tools/smoke-verticals.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.15.0",
    "pg": "^8.13.1"
  }
}
